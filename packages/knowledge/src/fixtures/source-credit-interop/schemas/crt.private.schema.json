{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Neuronautix/ComputationalReviewTemplate_trust-knowledge/docs/contracts/contributorship/v1/contributorship.private.schema.json",
  "title": "comprev.contributorship/1 (private)",
  "description": "Full contributorship and source-finding credit lineage record for an exact review version. For the authorised workspace only; publish the public projection instead.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "visibility", "credit_standard", "subject", "contributors", "credit_assertions", "legacy_role_labels", "production", "source_origins", "source_credit", "relation_proposals"],
  "properties": {
    "schema": { "const": "comprev.contributorship/1" },
    "visibility": { "const": "private" },
    "credit_standard": { "const": "ANSI/NISO Z39.104-2022" },
    "subject": { "$ref": "#/$defs/subject" },
    "contributors": { "type": "array", "items": { "$ref": "#/$defs/contributor" } },
    "credit_assertions": { "type": "array", "items": { "$ref": "#/$defs/assertion" } },
    "legacy_role_labels": { "type": "array", "items": { "$ref": "#/$defs/personLegacyLabel" } },
    "production": {
      "type": "object",
      "additionalProperties": false,
      "required": ["agent_runs"],
      "properties": { "agent_runs": { "type": "array", "items": { "$ref": "#/$defs/agentRun" } } }
    },
    "source_origins": { "type": "array", "items": { "$ref": "#/$defs/sourceOrigin" } },
    "source_credit": { "type": "array", "items": { "$ref": "#/$defs/sourceCredit" } },
    "relation_proposals": { "type": "array", "items": { "$ref": "#/$defs/relationProposal" } }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,63}$" },
    "nullableText": { "type": ["string", "null"], "minLength": 1 },
    "nullableRef": { "type": ["string", "null"], "minLength": 1 },
    "sha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "claimId": { "type": "string", "pattern": "^clm_[a-f0-9]{16}$" },
    "timestamp": { "type": "string", "format": "date-time", "pattern": "Z$" },
    "creditSlug": { "enum": ["conceptualization", "data-curation", "formal-analysis", "funding-acquisition", "investigation", "methodology", "project-administration", "resources", "software", "supervision", "validation", "visualization", "writing-original-draft", "writing-review-editing"] },
    "disclosure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["public", "reason", "approval_ids"],
      "properties": {
        "public": { "type": "boolean" },
        "reason": { "type": ["string", "null"] },
        "approved_fields": { "type": "array", "items": { "enum": ["display_name", "orcid", "credit_assertions"] } },
        "approval_ids": { "type": "array", "items": { "type": "string" } }
      }
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["review_id", "version", "claim_graph_sha256"],
      "properties": {
        "review_id": { "type": "string", "pattern": "^review-[a-z0-9][a-z0-9-]{2,63}$" },
        "version": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$" },
        "claim_graph_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "orcid": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["id", "status"],
      "properties": {
        "id": { "type": "string", "pattern": "^\\d{4}-\\d{4}-\\d{4}-\\d{3}[\\dX]$" },
        "status": { "enum": ["claimed", "verified"] },
        "verification": {
          "type": "object",
          "additionalProperties": false,
          "required": ["method", "ref", "verified_at"],
          "properties": {
            "method": { "enum": ["orcid-oauth", "controller-check"] },
            "ref": { "type": "string", "minLength": 1 },
            "verified_at": { "$ref": "#/$defs/timestamp" }
          }
        }
      },
      "if": { "properties": { "status": { "const": "verified" } } },
      "then": { "required": ["verification"] },
      "else": { "not": { "required": ["verification"] } }
    },
    "contributor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "display_name", "orcid", "legacy_author_id", "credit_statement", "disclosure"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": { "const": "person" },
        "display_name": { "type": "string", "minLength": 1 },
        "orcid": { "$ref": "#/$defs/orcid" },
        "legacy_author_id": { "$ref": "#/$defs/nullableRef" },
        "credit_statement": { "$ref": "#/$defs/nullableText" },
        "disclosure": { "$ref": "#/$defs/disclosure" }
      }
    },
    "target": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["kind"], "properties": { "kind": { "const": "review" } } },
        { "type": "object", "additionalProperties": false, "required": ["kind", "claim_id"], "properties": { "kind": { "const": "claim" }, "claim_id": { "$ref": "#/$defs/claimId" } } }
      ]
    },
    "assertion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assertion_id", "contributor", "role", "role_label", "role_uri", "degree", "status", "status_ref", "source_kind", "source_ref", "asserted_at", "target"],
      "properties": {
        "assertion_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9:._-]{0,127}$" },
        "contributor": { "$ref": "#/$defs/id" },
        "role": { "$ref": "#/$defs/creditSlug" },
        "role_label": { "type": "string" },
        "role_uri": { "type": "string", "pattern": "^https://credit\\.niso\\.org/contributor-roles/[a-z-]+/$" },
        "degree": { "enum": ["lead", "equal", "supporting", null] },
        "status": { "enum": ["declared", "confirmed", "disputed", "withdrawn"] },
        "status_ref": { "$ref": "#/$defs/nullableRef" },
        "source_kind": { "enum": ["self-declared", "corresponding-author", "controller", "legacy-author-file"] },
        "source_ref": { "type": "string", "minLength": 1 },
        "asserted_at": { "anyOf": [{ "$ref": "#/$defs/timestamp" }, { "type": "null" }] },
        "target": { "$ref": "#/$defs/target" }
      },
      "if": { "properties": { "status": { "const": "declared" } } },
      "then": { "properties": { "status_ref": { "type": "null" } } },
      "else": { "properties": { "status_ref": { "type": "string", "minLength": 1 } } }
    },
    "legacyLabelFields": {
      "type": "object",
      "required": ["field", "position", "label", "level", "mapped_role", "mapping", "credit_eligible"],
      "properties": {
        "field": { "enum": ["roles", "credit_levels"] },
        "position": { "type": "integer", "minimum": 0 },
        "label": { "type": ["string", "null"] },
        "level": { "type": ["string", "null"] },
        "mapped_role": { "anyOf": [{ "$ref": "#/$defs/creditSlug" }, { "type": "null" }] },
        "mapping": { "enum": ["exact", "normalized", "unmappable"] },
        "credit_eligible": { "type": "boolean" }
      }
    },
    "personLegacyLabel": {
      "allOf": [{ "$ref": "#/$defs/legacyLabelFields" }],
      "type": "object",
      "required": ["contributor", "source_ref"],
      "properties": {
        "contributor": { "$ref": "#/$defs/id" },
        "source_ref": { "type": "string", "minLength": 1 },
        "field": true, "position": true, "label": true, "level": true, "mapped_role": true, "mapping": true, "credit_eligible": true
      },
      "additionalProperties": false
    },
    "agentLegacyLabel": {
      "allOf": [{ "$ref": "#/$defs/legacyLabelFields" }],
      "type": "object",
      "properties": {
        "field": true, "position": true, "label": true, "level": true, "mapped_role": true, "mapping": true,
        "credit_eligible": { "const": false }
      },
      "additionalProperties": false
    },
    "agentRun": {
      "type": "object",
      "additionalProperties": false,
      "required": ["agent_id", "kind", "name", "version", "workflow_role", "producer", "credit_channel", "legacy_author_id", "legacy_role_labels"],
      "properties": {
        "agent_id": { "$ref": "#/$defs/id" },
        "kind": { "const": "software-agent" },
        "name": { "type": "string", "minLength": 1 },
        "version": { "$ref": "#/$defs/nullableText" },
        "workflow_role": { "$ref": "#/$defs/nullableText" },
        "producer": { "$ref": "#/$defs/nullableText" },
        "credit_channel": { "const": "production" },
        "legacy_author_id": { "$ref": "#/$defs/nullableRef" },
        "legacy_role_labels": { "type": "array", "items": { "$ref": "#/$defs/agentLegacyLabel" } }
      }
    },
    "sourceOrigin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["origin_id", "packet_id", "visibility", "project_ref", "project_title", "disclosure"],
      "properties": {
        "origin_id": { "$ref": "#/$defs/id" },
        "packet_id": { "type": "string", "pattern": "^packet:" },
        "visibility": { "enum": ["public", "private"] },
        "project_ref": { "$ref": "#/$defs/nullableRef" },
        "project_title": { "$ref": "#/$defs/nullableText" },
        "disclosure": { "$ref": "#/$defs/disclosure" }
      }
    },
    "sourceFinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["finding_id", "finding_revision", "phase2_finding_sha256", "binding", "origin_id", "decision_ref", "mapped_at", "lineage_sha256", "packet", "cited_work", "passage_disclosure", "passages", "source_assessments", "source_curation"],
      "properties": {
        "finding_id": { "type": "string", "pattern": "^finding:" },
        "finding_revision": { "type": "integer", "minimum": 1 },
        "phase2_finding_sha256": { "$ref": "#/$defs/sha256" },
        "binding": { "const": "reviewed-mapping" },
        "origin_id": { "$ref": "#/$defs/id" },
        "decision_ref": { "type": "string", "minLength": 1 },
        "mapped_at": { "$ref": "#/$defs/timestamp" },
        "lineage_sha256": { "$ref": "#/$defs/sha256" },
        "packet": {
          "type": "object",
          "additionalProperties": false,
          "required": ["packet_id", "manifest_sha256"],
          "properties": { "packet_id": { "type": "string", "pattern": "^packet:" }, "manifest_sha256": { "$ref": "#/$defs/sha256" } }
        },
        "cited_work": {
          "type": "object",
          "additionalProperties": false,
          "required": ["credit_kind", "cite_key", "doi", "authors"],
          "properties": {
            "credit_kind": { "const": "bibliographic-citation" },
            "cite_key": { "type": ["string", "null"] },
            "doi": { "type": "string", "pattern": "^10\\." },
            "authors": { "type": "array", "items": { "type": "string" } }
          }
        },
        "passage_disclosure": { "enum": ["rights-allow", "rights-restricted"] },
        "passages": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["passage_id", "quote_sha256"],
            "properties": { "passage_id": { "type": "string", "pattern": "^passage:" }, "quote_sha256": { "$ref": "#/$defs/sha256" } }
          }
        },
        "source_assessments": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["assessment_id", "protocol", "status", "curator_ref", "curator_ref_kind"],
            "properties": {
              "assessment_id": { "type": "string", "pattern": "^assessment:" },
              "protocol": { "type": "string", "minLength": 1 },
              "status": { "type": "string", "minLength": 1 },
              "curator_ref": { "type": "string", "minLength": 1 },
              "curator_ref_kind": { "const": "source-native-pseudonym" }
            }
          }
        },
        "source_curation": { "$ref": "#/$defs/sourceCuration" }
      }
    },
    "sourceCuration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["credit_channel", "review_authorship"],
      "properties": { "credit_channel": { "const": "source-native" }, "review_authorship": { "const": false } }
    },
    "sourceCredit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claim_id", "findings", "disclosure"],
      "properties": {
        "claim_id": { "$ref": "#/$defs/claimId" },
        "findings": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/sourceFinding" } },
        "disclosure": { "$ref": "#/$defs/disclosure" }
      }
    },
    "findingRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["finding_id", "finding_revision"],
      "properties": { "finding_id": { "type": "string", "pattern": "^finding:" }, "finding_revision": { "type": "integer", "minimum": 1 } }
    },
    "relationProposal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relation_id", "proposed_by", "predicate", "finding_refs", "proposed_at", "rationale", "disclosure"],
      "properties": {
        "relation_id": { "type": "string", "minLength": 1 },
        "proposed_by": { "$ref": "#/$defs/id" },
        "predicate": { "enum": ["supports", "contradicts", "qualifies"] },
        "claim_id": { "$ref": "#/$defs/claimId" },
        "finding_refs": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/findingRef" } },
        "proposed_at": { "$ref": "#/$defs/timestamp" },
        "rationale": { "$ref": "#/$defs/nullableText" },
        "disclosure": { "$ref": "#/$defs/disclosure" }
      }
    }
  }
}
