{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Neuronautix/ComputationalReviewTemplate_trust-knowledge/project-artifacts/0.1/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "scope",
    "access_effect",
    "project",
    "source",
    "workflow",
    "artifacts"
  ],
  "properties": {
    "protocol": {
      "const": "research-project-artifacts/0.1"
    },
    "scope": {
      "const": "private-descriptor"
    },
    "access_effect": {
      "const": "none"
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "research_question"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "research_question": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "repository",
        "commit",
        "visibility"
      ],
      "properties": {
        "provider": {
          "const": "github"
        },
        "repository": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9]|-(?=[A-Za-z0-9])){0,38}/(?!\\.{1,2}(?![\\s\\S]))[A-Za-z0-9_.-]{1,100}(?![\\s\\S])"
        },
        "commit": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-f0-9]{40}(?![\\s\\S])"
        },
        "visibility": {
          "type": "string",
          "enum": [
            "private",
            "public"
          ]
        }
      }
    },
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phase",
        "run_id"
      ],
      "properties": {
        "phase": {
          "type": "string",
          "minLength": 1
        },
        "run_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "path",
          "sha256",
          "bytes",
          "kind",
          "state",
          "visibility",
          "rights",
          "clearance",
          "generator"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z][a-z0-9-]*(?![\\s\\S])"
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          },
          "kind": {
            "type": "string",
            "enum": [
              "reading-corpus",
              "literature-packet",
              "working-draft",
              "claim-graph",
              "contributorship",
              "human-decisions",
              "provenance",
              "reviewed-release"
            ]
          },
          "state": {
            "type": "string",
            "enum": [
              "working",
              "reviewed",
              "released"
            ]
          },
          "visibility": {
            "type": "string",
            "enum": [
              "private",
              "restricted",
              "public"
            ]
          },
          "rights": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "license",
              "redistribution"
            ],
            "properties": {
              "license": {
                "type": "string",
                "minLength": 1
              },
              "redistribution": {
                "type": "string",
                "enum": [
                  "allowed",
                  "prohibited",
                  "unknown"
                ]
              }
            }
          },
          "clearance": {
            "type": "string",
            "enum": [
              "current",
              "withdrawn"
            ]
          },
          "generator": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "name",
                  "version",
                  "role",
                  "run_id"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "version": {
                    "type": "string",
                    "minLength": 1
                  },
                  "role": {
                    "type": "string",
                    "minLength": 1
                  },
                  "run_id": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            ]
          }
        }
      }
    }
  }
}
