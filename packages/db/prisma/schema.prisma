// Open Review Atlas — core data model (spec §9).
//
// SQLite for zero-configuration local development; the schema deliberately
// avoids SQLite-only and Postgres-only features so switching the datasource
// provider to "postgresql" is a configuration change:
//   - enums are String columns validated by @oratlas/contracts at the app layer
//   - JSON payloads are String columns containing JSON ("...Json" suffix)
//   - arrays (topics, roles, keywords) are JSON-encoded String columns
generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                    String    @id @default(cuid())
  githubUserId          String?   @unique
  githubLogin           String    @unique
  /// NFKC + lowercase login used solely for collision prevention.
  /// Transitional: application-enforced uniqueness until issue #7.
  githubLoginNormalized String?
  displayName           String?
  avatarUrl             String?
  profileUrl            String?
  /// USER | EDITOR | ADMIN
  role                  String    @default("USER")
  /// Reviewer ORCID iD (contracts orcidSchema). Unverified until an ORCID
  /// sign-in confirms it; reports snapshot the verification state.
  orcid                 String?
  orcidVerifiedAt       DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  submissions                     Submission[]                      @relation("submitter")
  editorialDecisions              Submission[]                      @relation("reviewer")
  discussionThreads               DiscussionThread[]
  reviewComments                  ReviewComment[]
  auditEvents                     AuditEvent[]
  trustVerifications              TrustVerification[]               @relation("trustReviewer")
  nodeRelationTrustVerifications  NodeRelationTrustVerification[]   @relation("nodeRelationTrustReviewer")
  inspectionCaptures              InspectionCapture[]
  editorialOverrides              EditorialOverride[]
  lifecycleEvents                 ReviewLifecycleEvent[]            @relation("lifecycleActor")
  editorAssignments               EditorAssignment[]                @relation("assignmentEditor")
  assignmentsMade                 EditorAssignment[]                @relation("assignmentAssigner")
  roundsOpened                    ReviewRound[]                     @relation("roundOpener")
  formalReports                   FormalReviewReport[]              @relation("formalReviewer")
  authorResponses                 AuthorResponse[]                  @relation("respondingAuthor")
  decisionLetters                 DecisionLetter[]                  @relation("decisionEditor")
  notifications                   Notification[]                    @relation("notificationUser")
  statusRecords                   CitationStatusRecord[]            @relation("statusRecorder")
  proposalsResolved               ClaimUpdateProposal[]             @relation("proposalResolver")
  protocolSnapshots               ProtocolSnapshot[]                @relation("protocolSnapshotCreator")
  protocolProposalsResolved       ProtocolDriftProposal[]           @relation("protocolProposalResolver")
  passportsRegistered             ExecutionPassport[]               @relation("passportRegistrant")
  passportsVerified               ExecutionPassport[]               @relation("passportVerifier")
  federationResolved              FederationNotification[]          @relation("federationResolver")
  replicationBriefsCreated        ReplicationBrief[]                @relation("replicationCreator")
  replicationBriefsPublished      ReplicationBrief[]                @relation("replicationPublisher")
  replicationBriefsClaimed        ReplicationBrief[]                @relation("replicationClaimant")
  replicationBriefsCompleted      ReplicationBrief[]                @relation("replicationCompleter")
  replicationBriefsWithdrawn      ReplicationBrief[]                @relation("replicationWithdrawer")
  nodeEdgeProposalsReviewed       NodeEdgeProposal[]                @relation("nodeEdgeProposalReviewer")
  nodeIdentityProposalsReviewed   NodeIdentityProposal[]            @relation("nodeIdentityProposalReviewer")
  nodeEdgesConfirmed              NodeEdge[]                        @relation("nodeEdgeConfirmer")
  synthesisDraftsApproved         SynthesisDraft[]                  @relation("synthesisDraftApprover")
  synthesisVersionsApproved       ReviewVersion[]                   @relation("synthesisVersionApprover")
  synthesisAttributions           SynthesisAttributionContributor[] @relation("synthesisAttributionUser")
  synthesisRegenerationResolved   SynthesisRegenerationProposal[]   @relation("synthesisRegenerationResolver")
  challengesFiled                 Challenge[]                       @relation("challengeChallenger")
  challengeTransitions            ChallengeTransition[]             @relation("challengeTransitionActor")
  challengeResponses              ChallengeResponse[]               @relation("challengeResponder")
  challengeContentRemovals        Challenge[]                       @relation("challengeContentRemover")
  challengeResponseRemovals       ChallengeResponse[]               @relation("challengeResponseRemover")
  nodeChallengeContributions      ChallengeResponse[]               @relation("nodeChallengeContributor")
  trustAdjudications              TrustAdjudication[]               @relation("trustAdjudicator")
  adjudicatorDesignation          TrustAdjudicatorDesignation?      @relation("designatedAdjudicator")
  adjudicatorDesignationsMade     TrustAdjudicatorDesignation[]     @relation("adjudicatorDesignator")
  productionAssertions            PublicationProductionAssertion[]  @relation("productionAssertionActor")
  publicationRelationsReviewed    PublicationRelation[]             @relation("publicationRelationReviewer")
  certifiersCreated               Certifier[]                       @relation("certifierCreator")
  certificationCredentialsIssued  CertifierCredential[]             @relation("credentialIssuer")
  certificationCredentialsRevoked CertifierCredential[]             @relation("credentialRevoker")
  certificationRunsRequested      CertificationRun[]                @relation("certificationRunRequester")
  certificationLifecycleEvents    CertificationLifecycleEvent[]     @relation("certificationLifecycleActor")

  @@index([githubLoginNormalized])
}

model Repository {
  id                 String    @id @default(cuid())
  /// Always "github.com" in the POC.
  host               String    @default("github.com")
  owner              String
  name               String
  canonicalUrl       String    @unique
  /// Immutable GitHub database id. Decimal string avoids 32-bit truncation.
  githubRepositoryId String?   @unique
  defaultBranch      String?
  description        String?
  licenseSpdx        String?
  /// JSON array of topic strings.
  topicsJson         String    @default("[]")
  homepageUrl        String?
  pagesUrl           String?
  isArchived         Boolean   @default(false)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  lastInspectedAt    DateTime?

  snapshots      RepositorySnapshot[]
  submissions    Submission[]
  reviews        Review[]
  knowledgeNodes KnowledgeNode[]

  @@unique([host, owner, name])
}

model RepositorySnapshot {
  id                   String    @id @default(cuid())
  repositoryId         String
  commitSha            String
  /// Legacy selection fields. New writes keep source selection on Submission
  /// and ReviewVersion because one commit can be reached through many refs.
  branch               String?
  releaseTag           String?
  releaseUrl           String?
  /// When the commit/release was created on GitHub.
  sourceCreatedAt      DateTime?
  capturedAt           DateTime  @default(now())
  /// succeeded | partial | failed
  inspectionStatus     String
  inspectionReportJson String
  /// Git tree object belonging to commitSha.
  sourceTreeSha        String?
  /// default-branch | tag | release
  sourceKind           String?
  /// Validated review manifest content, when present.
  manifestJson         String?
  /// Durable canonical-JSON copy of preserved textual file contents
  /// (contracts preservedFilesSchema), written at submission so preservation
  /// never depends on the ephemeral inspect-to-submit capability row.
  preservedFilesJson   String?
  /// SHA-256 over the normalized inspection payload (integrity/versioning aid).
  contentHash          String

  repository            Repository             @relation(fields: [repositoryId], references: [id])
  submissions           Submission[]
  reviewVersions        ReviewVersion[]
  knowledgeNodeVersions KnowledgeNodeVersion[]
  currentOf             Review[]               @relation("currentSnapshot")

  @@unique([repositoryId, commitSha])
}

model Review {
  id                        String    @id @default(cuid())
  /// Stable canonical review-node identity. Nullable during expand/backfill.
  knowledgeNodeId           String?   @unique
  slug                      String    @unique
  /// Stable repository identity; prevents concurrent duplicate review rows.
  repositoryId              String?   @unique
  currentSnapshotId         String?
  /// Authoritative identity/head for ai-synthesis series; absent on repository reviews.
  synthesisSeriesKey        String?   @unique
  currentSynthesisVersionId String?   @unique
  title                     String
  abstract                  String?
  /// contracts REVIEW_TYPES
  reviewType                String?
  licenseSpdx               String?
  publishedReviewUrl        String?
  /// published | withdrawn | superseded
  status                    String    @default("published")
  acceptedAt                DateTime?
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt
  /// Optimistic-concurrency counter for append-only public lifecycle events.
  lifecycleRevision         Int       @default(0)

  currentSnapshot                RepositorySnapshot?             @relation("currentSnapshot", fields: [currentSnapshotId], references: [id])
  currentSynthesisVersion        ReviewVersion?                  @relation("currentSynthesisHead", fields: [currentSynthesisVersionId], references: [id])
  repository                     Repository?                     @relation(fields: [repositoryId], references: [id])
  knowledgeNode                  KnowledgeNode?                  @relation("reviewKnowledgeNode", fields: [knowledgeNodeId], references: [id], onDelete: Restrict)
  versions                       ReviewVersion[]
  comments                       ReviewComment[]
  lifecycleEvents                ReviewLifecycleEvent[]
  synthesisDrafts                SynthesisDraft[]
  synthesisStalenessHeads        SynthesisStalenessHead[]
  synthesisStalenessEvaluations  SynthesisStalenessEvaluation[]
  synthesisRegenerationProposals SynthesisRegenerationProposal[]
  publicationProjection          Publication?                    @relation("reviewPublicationProjection")
}

model ReviewVersion {
  id                                    String    @id @default(cuid())
  reviewId                              String
  snapshotId                            String?
  /// repository | synthesis. Synthesis rows must have no snapshot or fake commit.
  recordSourceType                      String    @default("repository")
  synthesisDraftId                      String?   @unique
  /// First submission that materialized this version (idempotency provenance).
  sourceSubmissionId                    String?   @unique
  inspectionCaptureId                   String?   @unique
  /// Exact source selection accepted for this version.
  sourceKind                            String?
  sourceBranch                          String?
  sourceSelectionKey                    String?
  tagObjectSha                          String?
  sourceCreatedAt                       DateTime?
  semanticVersion                       String?
  title                                 String
  abstract                              String?
  /// Effective metadata + provenance for this immutable version.
  metadataJson                          String
  versionDoi                            String?
  conceptDoi                            String?
  zenodoRecordId                        String?
  releaseTag                            String?
  releaseUrl                            String?
  /// Public, immutable release/DOI/commit consistency evidence.
  publicationConsistencyJson            String?
  /// SHA-256 of the exact canonical inspection capture accepted here.
  capturePayloadHash                    String?
  /// True when every DOI/identifier on this version is a synthetic example
  /// (seed/demo data). The UI must not render outbound resolvers for these.
  isExample                             Boolean   @default(false)
  publishedAt                           DateTime?
  createdAt                             DateTime  @default(now())
  /// published | withdrawn | tombstoned. Updated only in the same
  /// transaction that appends an attributable lifecycle event.
  publicState                           String    @default("published")
  synthesisDocumentJson                 String?
  synthesisOrdinal                      Int?
  synthesisGenerationMode               String?
  synthesisPipelineName                 String?
  synthesisPipelineId                   String?
  synthesisPipelineKind                 String?
  synthesisPipelineVersion              String?
  synthesisProvider                     String?
  synthesisModel                        String?
  synthesisModelVersion                 String?
  synthesisPromptVersion                String?
  synthesisPromptHash                   String?
  synthesisPacketHash                   String?
  synthesisDocumentHash                 String?
  synthesisGeneratedAt                  DateTime?
  synthesisAcceptedAt                   DateTime?
  synthesisApprovedById                 String?
  synthesisApproverRole                 String?
  synthesisApproverDisplayName          String?
  synthesisApproverGithubLogin          String?
  synthesisChecklistVersion             String?
  synthesisAttributionPolicyVersion     String?
  synthesisMaterializationPolicyVersion String?
  synthesisRightsStatement              String?
  synthesisLicenseSpdx                  String?
  acceptedPredecessorVersionId          String?

  review                         Review                            @relation(fields: [reviewId], references: [id])
  snapshot                       RepositorySnapshot?               @relation(fields: [snapshotId], references: [id])
  synthesisDraft                 SynthesisDraft?                   @relation(fields: [synthesisDraftId], references: [id])
  synthesisApprovedBy            User?                             @relation("synthesisVersionApprover", fields: [synthesisApprovedById], references: [id])
  acceptedPredecessor            ReviewVersion?                    @relation("synthesisVersionPredecessor", fields: [acceptedPredecessorVersionId], references: [id])
  synthesisSuccessors            ReviewVersion[]                   @relation("synthesisVersionPredecessor")
  synthesisAttributions          SynthesisAttributionContributor[]
  challenges                     Challenge[]
  synthesisStalenessHead         SynthesisStalenessHead?
  synthesisStalenessEvaluations  SynthesisStalenessEvaluation[]    @relation("synthesisStalenessVersion")
  synthesisRegenerationProposals SynthesisRegenerationProposal[]   @relation("synthesisRegenerationVersion")
  currentSynthesisOf             Review?                           @relation("currentSynthesisHead")
  contributors                   ReviewContributor[]
  identifiers                    Identifier[]
  claims                         Claim[]
  citations                      Citation[]
  comments                       ReviewComment[]
  sourceSubmission               Submission?                       @relation("VersionSource", fields: [sourceSubmissionId], references: [id])
  inspectionCapture              InspectionCapture?                @relation(fields: [inspectionCaptureId], references: [id])
  resultingSubmissions           Submission[]                      @relation("ResultingVersion")
  lifecycleEvents                ReviewLifecycleEvent[]            @relation("lifecycleTarget")
  supersededByEvents             ReviewLifecycleEvent[]            @relation("lifecycleSupersededVersion")
  federationNotifications        FederationNotification[]
  protocolSnapshots              ProtocolSnapshot[]
  graphVersion                   KnowledgeNodeVersion?             @relation("reviewGraphVersion")

  @@unique([reviewId, snapshotId, sourceSelectionKey])
  @@unique([reviewId, synthesisOrdinal])
}

/// Corrections, withdrawals and tombstones are immutable public events. The
/// materialized ReviewVersion.publicState is only a fail-closed access guard;
/// this append-only ledger remains the attributable scholarly record.
model ReviewLifecycleEvent {
  id                  String   @id @default(cuid())
  reviewId            String
  reviewVersionId     String
  actorId             String
  /// correction | withdrawal | tombstone
  kind                String
  reason              String
  supersedesVersionId String?
  /// Resulting Review.lifecycleRevision. Unique per review supplies CAS.
  revision            Int
  createdAt           DateTime @default(now())

  review            Review         @relation(fields: [reviewId], references: [id])
  reviewVersion     ReviewVersion  @relation("lifecycleTarget", fields: [reviewVersionId], references: [id])
  supersedesVersion ReviewVersion? @relation("lifecycleSupersededVersion", fields: [supersedesVersionId], references: [id])
  actor             User           @relation("lifecycleActor", fields: [actorId], references: [id])

  @@unique([reviewId, revision])
  @@index([reviewVersionId, createdAt])
  @@index([kind, createdAt])
}

/// Server-side, opaque, expiring inspect-to-submit capability. Payloads are
/// append-only; consumption and submission creation occur in one transaction.
model InspectionCapture {
  id                    String                 @id @default(cuid())
  tokenHash             String                 @unique
  payloadJson           String
  payloadHash           String
  githubRepositoryId    String
  canonicalUrlAtCapture String
  inspectedByUserId     String
  commitSha             String
  releaseTag            String?
  createdAt             DateTime               @default(now())
  expiresAt             DateTime
  consumedAt            DateTime?
  inspectedBy           User                   @relation(fields: [inspectedByUserId], references: [id])
  submission            Submission?
  reviewVersion         ReviewVersion?
  knowledgeNodeVersions KnowledgeNodeVersion[] @relation("NodeVersionCapture")
  nodeEdgeProposals     NodeEdgeProposal[]     @relation("NodeEdgeProposalCapture")

  @@index([expiresAt])
  @@index([payloadHash])
}

model Person {
  id          String  @id @default(cuid())
  displayName String
  givenName   String?
  familyName  String?
  orcid       String?
  githubLogin String?

  contributions      ReviewContributor[]
  challengeResponses ChallengeResponse[]
}

model ReviewContributor {
  reviewVersionId String
  personId        String
  /// JSON array of role strings (e.g. ["author"], ["maintainer"]).
  rolesJson       String @default("[]")
  position        Int

  reviewVersion ReviewVersion @relation(fields: [reviewVersionId], references: [id])
  person        Person        @relation(fields: [personId], references: [id])

  @@id([reviewVersionId, personId])
}

model Submission {
  id                         String    @id @default(cuid())
  submitterId                String
  repositoryId               String
  snapshotId                 String?
  inspectionCaptureId        String?   @unique
  /// Exact selection provenance from the consumed inspection capture.
  sourceKind                 String?
  sourceBranch               String?
  sourceSelectionKey         String?
  releaseTag                 String?
  releaseUrl                 String?
  tagObjectSha               String?
  sourceCreatedAt            DateTime?
  /// contracts SUBMISSION_STATUSES
  status                     String    @default("draft")
  extractedMetadataJson      String?
  editedMetadataJson         String?
  validationReportJson       String?
  /// Immutable snapshot of the exact payload the submitter finalized.
  submittedPayloadJson       String?
  submittedPayloadHash       String?
  /// Canonical JSON array of local node ids selected during acceptance.
  acceptedNodeSelectionJson  String?
  /// SHA-256 of acceptedNodeSelectionJson for idempotent acceptance retries.
  acceptedNodeSelectionHash  String?
  submittedAt                DateTime?
  reviewedAt                 DateTime?
  reviewerId                 String?
  editorialNote              String?
  /// Public consistency report produced from the exact captured source.
  publicationConsistencyJson String?
  /// Review created/updated when this submission was accepted.
  resultingReviewId          String?
  resultingReviewVersionId   String?
  /// Revision lineage: the changes-requested submission this one resubmits.
  previousSubmissionId       String?   @unique
  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt

  submitter              User                         @relation("submitter", fields: [submitterId], references: [id])
  reviewer               User?                        @relation("reviewer", fields: [reviewerId], references: [id])
  repository             Repository                   @relation(fields: [repositoryId], references: [id])
  snapshot               RepositorySnapshot?          @relation(fields: [snapshotId], references: [id])
  inspectionCapture      InspectionCapture?           @relation(fields: [inspectionCaptureId], references: [id])
  sourceVersion          ReviewVersion?               @relation("VersionSource")
  resultingReviewVersion ReviewVersion?               @relation("ResultingVersion", fields: [resultingReviewVersionId], references: [id])
  sourceNodeVersions     KnowledgeNodeVersion[]       @relation("NodeVersionSource")
  editorialOverrides     EditorialOverride[]
  previousSubmission     Submission?                  @relation("Resubmission", fields: [previousSubmissionId], references: [id])
  resubmission           Submission?                  @relation("Resubmission")
  editorAssignments      EditorAssignment[]
  reviewRounds           ReviewRound[]
  nodeEdgeProposals      NodeEdgeProposal[]           @relation("NodeEdgeProposalSubmission")
  decisionProvenance     EditorialDecisionProvenance?
}

/// Immutable provenance for the legacy direct editorial decision endpoint.
/// Free-text notes remain on Submission and never enter public projections.
model EditorialDecisionProvenance {
  id                                       String    @id @default(cuid())
  submissionId                             String    @unique
  actorId                                  String
  actorGithubLoginSnapshot                 String
  actorRoleSnapshot                        String
  decision                                 String
  conflictOfInterestStatus                 String    @default("not-provided")
  administratorOverride                    Boolean   @default(false)
  administratorOverrideById                String?
  administratorOverrideGithubLoginSnapshot String?
  administratorOverrideAt                  DateTime?
  noteHash                                 String?
  decisionHash                             String
  createdAt                                DateTime  @default(now())

  submission Submission @relation(fields: [submissionId], references: [id])
}

/// An explicit, check-scoped editorial exception. Overrides never rewrite the
/// consistency report and are immutable once acceptance commits.
model EditorialOverride {
  id           String   @id @default(cuid())
  submissionId String
  checkId      String
  rationale    String
  editorId     String
  createdAt    DateTime @default(now())

  submission Submission @relation(fields: [submissionId], references: [id])
  editor     User       @relation(fields: [editorId], references: [id])

  @@unique([submissionId, checkId])
  @@index([editorId])
}

model Identifier {
  id                   String  @id @default(cuid())
  reviewVersionId      String
  /// doi | github | orcid | url | zenodo-record
  scheme               String
  value                String
  normalizedValue      String
  url                  String?
  /// version-doi | concept-doi | repository | release | published-review | zenodo-record | author-orcid
  relationType         String
  /// unvalidated | valid | valid-with-warnings | invalid | example-not-resolvable
  validationStatus     String  @default("unvalidated")
  validationReportJson String?
  /// Synthetic example identifier — never render as an outbound link.
  isExample            Boolean @default(false)

  reviewVersion ReviewVersion @relation(fields: [reviewVersionId], references: [id])

  @@index([scheme, normalizedValue])
}

model Claim {
  id              String   @id @default(cuid())
  reviewVersionId String
  /// Stable graph identity. Nullable only during expand/backfill.
  knowledgeNodeId String?
  /// Identifier within the source repository artifacts (e.g. "claim-003").
  localClaimId    String
  text            String
  normalizedText  String
  section         String?
  anchor          String?
  /// contracts CLAIM_TYPES
  claimType       String?
  qualification   String?
  /// Declared comparison scope (contracts claimScopeSchema JSON), for
  /// independence-aware synthesis. Absent when the repository declared none.
  scopeJson       String?
  createdAt       DateTime @default(now())

  reviewVersion      ReviewVersion            @relation(fields: [reviewVersionId], references: [id])
  knowledgeNode      KnowledgeNode?           @relation(fields: [knowledgeNodeId], references: [id])
  graphVersion       KnowledgeNodeVersion?    @relation("claimGraphVersion")
  evidenceRelations  ClaimEvidenceRelation[]
  linkProposalsFrom  KnowledgeLinkProposal[]  @relation("sourceClaim")
  linkProposalsTo    KnowledgeLinkProposal[]  @relation("targetClaim")
  comments           ReviewComment[]
  updateProposals    ClaimUpdateProposal[]
  protocolSnapshots  ProtocolSnapshot[]
  executionPassports ExecutionPassportClaim[]
  replicationBriefs  ReplicationBriefClaim[]
  challenges         Challenge[]              @relation("challengeClaim")

  @@unique([reviewVersionId, localClaimId])
  @@index([knowledgeNodeId])
}

/// Stable concept identity for one repository-local publication node. Content
/// lives only in immutable KnowledgeNodeVersion snapshots.
model KnowledgeNode {
  id           String   @id @default(cuid())
  /// Global stable identity key. Nullable only during expand/backfill.
  stableKey    String?  @unique
  /// repository-object | review-record | claim-occurrence | canonical-work
  originType   String   @default("repository-object")
  /// Required only for repository-object nodes; null for global/review identities.
  repositoryId String?
  /// Source-local identity (review id, claim occurrence id, or repository node id).
  localNodeId  String
  /// contracts KNOWLEDGE_NODE_KINDS: review | claim | work | figure | dataset | code
  kind         String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  repository            Repository?                  @relation(fields: [repositoryId], references: [id], onDelete: Restrict)
  review                Review?                      @relation("reviewKnowledgeNode")
  versions              KnowledgeNodeVersion[]
  incomingEdges         NodeEdge[]                   @relation("targetNode")
  incomingEdgeProposals NodeEdgeProposal[]           @relation("proposalTargetNode")
  linkedClaims          Claim[]
  linkedCitations       Citation[]                   @relation("citationWorkNode")
  aliases               NodeAlias[]
  identityProposalsFrom NodeIdentityProposal[]       @relation("identityProposalSource")
  identityProposalsTo   NodeIdentityProposal[]       @relation("identityProposalTarget")
  synthesisMemberships  SynthesisDraftMembership[]
  synthesisCitations    SynthesisDraftCitation[]
  publicationClaims     PublicationClaimOccurrence[] @relation("publicationClaimNode")

  @@unique([repositoryId, localNodeId])
  @@index([originType])
  @@index([kind])
}

/// Immutable content snapshot for a node at one exact repository commit. The
/// bound RepositorySnapshot supplies the commit SHA without duplicating it.
model KnowledgeNodeVersion {
  id                                 String   @id @default(cuid())
  knowledgeNodeId                    String
  /// Required only for repository-backed versions.
  snapshotId                         String?
  /// Exact relational object bindings. Nullable during expand/backfill.
  sourceReviewVersionId              String?  @unique
  sourceClaimId                      String?  @unique
  sourceCitationId                   String?  @unique
  /// Expand-only external-publication occurrence source. The exclusive source
  /// union already admits it; no writer materializes one yet.
  sourcePublicationClaimOccurrenceId String?  @unique
  /// Submission/capture that first materialized this version. A single
  /// acceptance can publish many nodes, so these provenance FKs are not unique.
  sourceSubmissionId                 String?
  inspectionCaptureId                String?
  /// SHA-256 of the exact canonical inspection capture accepted here.
  capturePayloadHash                 String?
  /// Repository display title; optional for canonical source records.
  title                              String?
  abstract                           String?
  text                               String?
  /// contracts ManifestContributor[] encoded as JSON.
  contributorsJson                   String   @default("[]")
  /// Repository-declared license; optional for canonical source records.
  license                            String?
  /// contracts KnowledgeNodeProvenance encoded as JSON.
  provenanceJson                     String
  /// Kind-specific contracts KnowledgeNode.payload encoded as JSON.
  payloadJson                        String
  versionDoi                         String?
  conceptDoi                         String?
  /// Synthetic example identifier marker; never render its DOI as outbound.
  isExample                          Boolean  @default(false)
  createdAt                          DateTime @default(now())

  knowledgeNode                    KnowledgeNode               @relation(fields: [knowledgeNodeId], references: [id])
  snapshot                         RepositorySnapshot?         @relation(fields: [snapshotId], references: [id], onDelete: Restrict)
  sourceReviewVersion              ReviewVersion?              @relation("reviewGraphVersion", fields: [sourceReviewVersionId], references: [id], onDelete: Restrict)
  sourceClaim                      Claim?                      @relation("claimGraphVersion", fields: [sourceClaimId], references: [id], onDelete: Restrict)
  sourceCitation                   Citation?                   @relation("citationGraphVersion", fields: [sourceCitationId], references: [id], onDelete: Restrict)
  sourcePublicationClaimOccurrence PublicationClaimOccurrence? @relation("publicationClaimGraphVersion", fields: [sourcePublicationClaimOccurrenceId], references: [id], onDelete: Restrict)
  sourceSubmission                 Submission?                 @relation("NodeVersionSource", fields: [sourceSubmissionId], references: [id])
  inspectionCapture                InspectionCapture?          @relation("NodeVersionCapture", fields: [inspectionCaptureId], references: [id])
  outgoingEdges                    NodeEdge[]                  @relation("sourceNodeVersion")
  proposedEdgesFrom                NodeEdgeProposal[]          @relation("proposalSourceVersion")
  proposedAsTarget                 NodeEdgeProposal[]          @relation("proposalTargetVersion")
  confirmedAsTarget                NodeEdge[]                  @relation("confirmedTargetVersion")
  synthesisMemberships             SynthesisDraftMembership[]
  synthesisCitations               SynthesisDraftCitation[]

  @@unique([knowledgeNodeId, snapshotId])
  @@index([snapshotId])
  @@index([sourceSubmissionId])
  @@index([inspectionCaptureId])
}

/// Directed, typed relation asserted from an immutable source version to a
/// stable target identity. Status and provenance use @oratlas/contracts enums.
model NodeEdge {
  id                           String    @id @default(cuid())
  sourceNodeVersionId          String
  targetNodeId                 String
  relationType                 String
  /// "canonical" for editorial edges; exact relation id for source assertions.
  edgeDiscriminator            String    @default("canonical")
  status                       String
  provenance                   String
  rationale                    String?
  assertedAt                   DateTime?
  createdAt                    DateTime  @default(now())
  updatedAt                    DateTime  @updatedAt
  confirmedTargetNodeVersionId String?
  confirmedById                String?
  confirmedAt                  DateTime?
  revision                     Int       @default(0)

  sourceNodeVersion          KnowledgeNodeVersion   @relation("sourceNodeVersion", fields: [sourceNodeVersionId], references: [id])
  targetNode                 KnowledgeNode          @relation("targetNode", fields: [targetNodeId], references: [id])
  confirmedTargetNodeVersion KnowledgeNodeVersion?  @relation("confirmedTargetVersion", fields: [confirmedTargetNodeVersionId], references: [id])
  confirmedBy                User?                  @relation("nodeEdgeConfirmer", fields: [confirmedById], references: [id])
  proposals                  NodeEdgeProposal[]     @relation("confirmedProposalEdge")
  claimEvidenceRelation      ClaimEvidenceRelation?

  @@unique([sourceNodeVersionId, targetNodeId, relationType, edgeDiscriminator])
  @@index([targetNodeId])
  @@index([status, relationType])
  @@index([confirmedTargetNodeVersionId])
}

/// An attributable author assertion or agent proposal. Editorial confirmation
/// materializes the separate NodeEdge while preserving this immutable origin.
model NodeEdgeProposal {
  id                  String    @id @default(cuid())
  originKey           String    @unique
  sourceStableKey     String
  targetStableKey     String
  sourceNodeVersionId String
  targetNodeId        String
  targetNodeVersionId String
  relationType        String
  /// asserted-by-author | proposed-by-agent
  origin              String
  rationale           String?
  evidenceJson        String    @default("{}")
  sourceSubmissionId  String?
  inspectionCaptureId String?
  agentRunId          String?
  /// proposed | confirmed | rejected | superseded
  status              String    @default("proposed")
  revision            Int       @default(0)
  reviewedById        String?
  reviewedAt          DateTime?
  reviewNote          String?
  confirmedEdgeId     String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  sourceNodeVersion KnowledgeNodeVersion          @relation("proposalSourceVersion", fields: [sourceNodeVersionId], references: [id])
  targetNode        KnowledgeNode                 @relation("proposalTargetNode", fields: [targetNodeId], references: [id])
  targetNodeVersion KnowledgeNodeVersion          @relation("proposalTargetVersion", fields: [targetNodeVersionId], references: [id])
  sourceSubmission  Submission?                   @relation("NodeEdgeProposalSubmission", fields: [sourceSubmissionId], references: [id])
  inspectionCapture InspectionCapture?            @relation("NodeEdgeProposalCapture", fields: [inspectionCaptureId], references: [id])
  agentRun          AgentRun?                     @relation(fields: [agentRunId], references: [id])
  reviewedBy        User?                         @relation("nodeEdgeProposalReviewer", fields: [reviewedById], references: [id])
  confirmedEdge     NodeEdge?                     @relation("confirmedProposalEdge", fields: [confirmedEdgeId], references: [id])
  trustAssessments  NodeRelationTrustAssessment[]
  adjudications     TrustAdjudication[]
  challenges        Challenge[]                   @relation("challengeNodeContainer")

  @@index([status, createdAt])
  @@index([sourceNodeVersionId])
  @@index([targetNodeId])
  @@index([confirmedEdgeId])
}

/// Canonical DOI/PMID/OpenAlex comparison key declared for a stable node.
/// The role remains explicit so version and concept DOI meaning is never lost.
/// Alias values are intentionally not globally unique: a shared value produces
/// a reviewable identity proposal and never merges the owning nodes.
model NodeAlias {
  id              String   @id @default(cuid())
  knowledgeNodeId String
  /// contracts nodeAliasSchemeSchema: doi | pmid | openalex
  scheme          String
  /// contracts nodeAliasRoleSchema; version/concept/artifact/work stay distinct.
  role            String
  /// Canonical value without a resolver/prefix (for example 10.1000/work).
  value           String
  /// Synthetic examples are stored for provenance but excluded from matching.
  isExample       Boolean  @default(false)
  createdAt       DateTime @default(now())

  knowledgeNode KnowledgeNode @relation(fields: [knowledgeNodeId], references: [id])

  @@unique([knowledgeNodeId, scheme, role, value])
  @@index([scheme, value])
}

/// A deterministic cross-repository identity suggestion. Confirming this row
/// publishes an "also asserted in" relationship; it never merges stable nodes
/// or combines their protocol-scoped assessments.
model NodeIdentityProposal {
  id                String    @id
  /// same-work | same-claim (C01 currently persists same-claim only)
  kind              String
  sourceNodeId      String
  targetNodeId      String
  signalsJson       String
  sharedAliasesJson String    @default("[]")
  sourceTextHash    String?
  targetTextHash    String?
  textSimilarity    Float?
  methodVersion     String
  /// proposed | confirmed | rejected
  status            String    @default("proposed")
  revision          Int       @default(0)
  reviewedById      String?
  reviewedAt        DateTime?
  reviewNote        String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  sourceNode KnowledgeNode @relation("identityProposalSource", fields: [sourceNodeId], references: [id], onDelete: Restrict)
  targetNode KnowledgeNode @relation("identityProposalTarget", fields: [targetNodeId], references: [id], onDelete: Restrict)
  reviewedBy User?         @relation("nodeIdentityProposalReviewer", fields: [reviewedById], references: [id], onDelete: Restrict)

  @@index([status, createdAt])
  @@index([sourceNodeId, status])
  @@index([targetNodeId, status])
}

/// A human-editor-published replication opportunity. Triage snapshots are
/// deterministic evidence-gap metadata only; they are never scientific truth
/// scores, outcome predictions, or rankings of the people who claim briefs.
model ReplicationBrief {
  id                      String    @id @default(cuid())
  requestKey              String    @unique
  requestHash             String
  slug                    String    @unique
  title                   String
  summary                 String
  scopeJson               String
  expectedInformationGain String
  effortBand              String
  protocolUrl             String?
  citationUrlsJson        String    @default("[]")
  /// draft | open | claimed | completed | withdrawn
  status                  String    @default("draft")
  /// Optimistic-concurrency counter for every lifecycle transition.
  revision                Int       @default(0)
  /// Snapshot of rule ids/counts at publication; no scalar score.
  triageSnapshotJson      String?
  createdById             String
  publishedById           String?
  publishedAt             DateTime?
  claimedById             String?
  claimedAt               DateTime?
  claimNote               String?
  completedById           String?
  completedAt             DateTime?
  completionUrl           String?
  completionSummary       String?
  withdrawnById           String?
  withdrawnAt             DateTime?
  withdrawalReason        String?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  createdBy   User                    @relation("replicationCreator", fields: [createdById], references: [id], onDelete: Restrict)
  publishedBy User?                   @relation("replicationPublisher", fields: [publishedById], references: [id], onDelete: Restrict)
  claimedBy   User?                   @relation("replicationClaimant", fields: [claimedById], references: [id], onDelete: Restrict)
  completedBy User?                   @relation("replicationCompleter", fields: [completedById], references: [id], onDelete: Restrict)
  withdrawnBy User?                   @relation("replicationWithdrawer", fields: [withdrawnById], references: [id], onDelete: Restrict)
  claims      ReplicationBriefClaim[]

  @@index([status, publishedAt])
  @@index([effortBand, status])
  @@index([claimedById, status])
}

model ReplicationBriefClaim {
  replicationBriefId String
  claimId            String
  position           Int

  replicationBrief ReplicationBrief @relation(fields: [replicationBriefId], references: [id])
  claim            Claim            @relation(fields: [claimId], references: [id])

  @@id([replicationBriefId, claimId])
  @@unique([replicationBriefId, position])
  @@index([claimId])
}

/// Offline-verified execution provenance bound to immutable Atlas claims.
/// Submitted repositories are never cloned or executed. Source JSON retains
/// the exact bounded crate/envelope so verification can be repeated later.
model ExecutionPassport {
  id                 String   @id @default(cuid())
  /// Always execution-attested for a valid public record. This label does not
  /// assert that results were reproduced or that a claim is scientifically true.
  status             String   @default("execution-attested")
  /// verified | failed. Public reads require verified and re-check hashes.
  verificationStatus String   @default("verified")
  revision           Int      @default(0)
  sourceJson         String
  crateSha256        String
  attestationSha256  String
  /// Canonical signed statement identity; envelope signature-array changes
  /// cannot create duplicate passports for the same attested execution.
  payloadSha256      String   @unique
  repositoryUrl      String
  commitSha          String
  treeSha            String
  workflowEntityId   String
  workflowPath       String
  workflowSha256     String
  workflowRunId      String
  workflowRunAttempt Int
  signingKeyId       String
  signingIssuer      String
  signingSubject     String
  issuedAt           DateTime
  registeredById     String
  lastVerifiedById   String
  registeredAt       DateTime @default(now())
  verifiedAt         DateTime @default(now())

  registeredBy         User                             @relation("passportRegistrant", fields: [registeredById], references: [id])
  lastVerifiedBy       User                             @relation("passportVerifier", fields: [lastVerifiedById], references: [id])
  claims               ExecutionPassportClaim[]
  artifacts            ExecutionPassportArtifact[]
  productionAssertions PublicationProductionAssertion[]
  certificationResults CertificationResult[]

  @@index([verificationStatus, registeredAt])
  @@index([commitSha])
}

model ExecutionPassportClaim {
  id         String @id @default(cuid())
  passportId String
  claimId    String

  passport ExecutionPassport @relation(fields: [passportId], references: [id])
  claim    Claim             @relation(fields: [claimId], references: [id])

  @@unique([passportId, claimId])
  @@index([claimId])
}

model ExecutionPassportArtifact {
  id         String  @id @default(cuid())
  passportId String
  entityId   String
  /// input | output
  role       String
  name       String
  path       String
  mediaType  String?
  byteSize   Int
  sha256     String

  passport ExecutionPassport @relation(fields: [passportId], references: [id])

  @@unique([passportId, entityId])
  @@index([passportId, role])
}

model Citation {
  id              String  @id @default(cuid())
  reviewVersionId String
  /// Persisted canonical identity decision; nullable during expand/backfill.
  workId          String?
  /// Stable canonical work node; nullable during expand/backfill.
  knowledgeNodeId String?
  localCitationId String
  doi             String?
  pmid            String?
  openAlexId      String?
  title           String?
  authorsJson     String  @default("[]")
  year            Int?
  source          String?
  url             String?
  /// Declared dataset/cohort accessions (JSON string array) and derivative
  /// source DOIs (JSON string array): deterministic independence signals.
  datasetIdsJson  String  @default("[]")
  derivedFromJson String  @default("[]")
  rawCitationJson String?

  reviewVersion        ReviewVersion           @relation(fields: [reviewVersionId], references: [id])
  knowledgeNode        KnowledgeNode?          @relation("citationWorkNode", fields: [knowledgeNodeId], references: [id], onDelete: Restrict)
  graphVersion         KnowledgeNodeVersion?   @relation("citationGraphVersion")
  workIdentityConflict WorkIdentityConflict?
  evidenceRelations    ClaimEvidenceRelation[]
  updateProposals      ClaimUpdateProposal[]

  @@unique([reviewVersionId, localCitationId])
  @@index([doi])
  @@index([workId])
  @@index([knowledgeNodeId])
}

/// Fail-closed record of ambiguous alias evidence encountered while resolving
/// a citation occurrence to a canonical work. The occurrence keeps a local
/// fallback work until an audited identity decision is made.
model WorkIdentityConflict {
  id                   String   @id @default(cuid())
  citationId           String   @unique
  reason               String
  aliasEvidenceJson    String
  candidateNodeIdsJson String
  createdAt            DateTime @default(now())

  citation Citation @relation(fields: [citationId], references: [id], onDelete: Restrict)
}

/// Singleton activation record for the deferred PostgreSQL canonical-graph contract.
model CanonicalGraphContractState {
  id             Int       @id
  enforced       Boolean   @default(false)
  backupId       String?
  manifestDigest String?
  enforcedAt     DateTime?
}

model ClaimEvidenceRelation {
  id                   String  @id @default(cuid())
  /// Canonical evidence edge; nullable during expand/backfill.
  nodeEdgeId           String? @unique
  claimId              String
  citationId           String
  /// contracts CLAIM_EVIDENCE_RELATION_TYPES
  relationType         String
  supportDirection     String?
  sourceLocation       String?
  extractionMethod     String?
  extractionConfidence Float?
  humanReviewed        Boolean @default(false)

  claim            Claim               @relation(fields: [claimId], references: [id])
  citation         Citation            @relation(fields: [citationId], references: [id])
  nodeEdge         NodeEdge?           @relation(fields: [nodeEdgeId], references: [id], onDelete: Restrict)
  trustAssessments TrustAssessment[]
  challenges       Challenge[]         @relation("challengeRelation")
  adjudications    TrustAdjudication[]

  @@unique([claimId, citationId, relationType])
}

/// TRUST attaches to a claim–citation relation, never to a citation globally.
/// Criterion-level records are authoritative; the aggregate is optional and
/// must carry the algorithm/version that produced it.
model TrustAssessment {
  id                       String    @id @default(cuid())
  claimEvidenceRelationId  String
  protocolVersion          String
  /// agent | human
  assessorType             String
  assessorId               String?
  assessedAt               DateTime?
  /// Immutable public source snapshot. Repository records missing it import as not-provided.
  conflictOfInterestStatus String    @default("not-provided")

  /// Each criterion: JSON {rating, status, rationale, evidencePointer} — the
  /// column stays queryable per criterion while remaining provider-portable.
  identityIntegrity             String?
  entailment                    String?
  sourceAccess                  String?
  populationRelevance           String?
  interventionExposureRelevance String?
  outcomeRelevance              String?
  methodologicalSafeguards      String?
  statisticalSafeguards         String?
  replicationConvergence        String?
  conflictDependency            String?

  limitationsJson String    @default("[]")
  evidenceJson    String?
  aggregateScore  Float?
  aggregateMethod String?
  /// Public imported state is always unverified-import. A valid separate
  /// TrustVerification marker can elevate it at read time.
  reviewStatus    String    @default("unverified-import")
  adjudicatorId   String?
  adjudicatedAt   DateTime?

  /// Exact repository assertions are provenance only, never platform trust.
  /// sourceRecordJson preserves absent versus explicit-null source fields.
  sourceRecordJson            String?
  sourceReviewStatus          String?
  sourceAssessorType          String?
  sourceAssessorId            String?
  sourceAssessedAt            DateTime?
  sourceEvidenceJson          String?
  sourceAggregateScore        Float?
  sourceAggregateMethod       String?
  sourceRelationHumanReviewed Boolean?

  /// Canonical source identity. Exact hash re-ingest is idempotent; a changed
  /// record in the same lineage creates a new row linked to its predecessor.
  sourceRecordHash       String?
  sourceLineageKey       String?
  supersedesAssessmentId String?

  /// Incremented by editorial verification writes for optimistic concurrency.
  revision  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  relation               ClaimEvidenceRelation        @relation(fields: [claimEvidenceRelationId], references: [id])
  verification           TrustVerification?
  supersedes             TrustAssessment?             @relation("TrustAssessmentSupersession", fields: [supersedesAssessmentId], references: [id])
  supersededBy           TrustAssessment[]            @relation("TrustAssessmentSupersession")
  challenges             Challenge[]                  @relation("challengeAssessment")
  adjudicationReferences TrustAdjudicationReference[]

  @@unique([claimEvidenceRelationId, sourceRecordHash])
  @@index([reviewStatus])
  @@index([claimEvidenceRelationId, sourceLineageKey])
}

/// Formal, attributed objection to one exact immutable scholarly subject.
/// The subject JSON and hash are server-derived; reads re-resolve and re-hash
/// the target so a stale or tampered binding fails closed.
model Challenge {
  id                         String    @id @default(cuid())
  /// Exactly one truthful public container is present: an immutable review
  /// version for legacy E01 subjects, or the exact node-edge proposal whose
  /// node-relation adjudication is challenged.
  reviewVersionId            String?
  nodeEdgeProposalId         String?
  /// claim | relation | assessment-criterion | adjudication
  subjectType                String
  claimId                    String?
  claimEvidenceRelationId    String?
  trustAssessmentId          String?
  trustAdjudicationId        String?
  criterion                  String?
  subjectRefJson             String
  canonicalSubjectHash       String
  /// entailment | source-access | methodology | identity | other
  grounds                    String
  /// Plain text only; bounded by contracts and rendered escaped.
  body                       String
  /// visible | removed. Removed bytes stay retained but never enter public DTOs.
  contentStatus              String    @default("visible")
  contentRevision            Int       @default(0)
  removedAt                  DateTime?
  removedById                String?
  removedByRoleSnapshot      String?
  /// Canonical digest of the immutable filed grounds/body and subject binding.
  filedContentHash           String
  challengerId               String
  /// SHA-256(challenger + exact subject hash) while the challenge is active.
  /// Nullable uniqueness is portable across SQLite/PostgreSQL and prevents
  /// concurrent duplicate filings without a provider-specific partial index.
  activeChallengerSubjectKey String?   @unique
  /// open | author-responded | resolved | dismissed | withdrawn
  status                     String    @default("open")
  revision                   Int       @default(0)
  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt

  reviewVersion ReviewVersion?         @relation(fields: [reviewVersionId], references: [id])
  nodeContainer NodeEdgeProposal?      @relation("challengeNodeContainer", fields: [nodeEdgeProposalId], references: [id])
  claim         Claim?                 @relation("challengeClaim", fields: [claimId], references: [id])
  relation      ClaimEvidenceRelation? @relation("challengeRelation", fields: [claimEvidenceRelationId], references: [id])
  assessment    TrustAssessment?       @relation("challengeAssessment", fields: [trustAssessmentId], references: [id])
  adjudication  TrustAdjudication?     @relation("challengeAdjudication", fields: [trustAdjudicationId], references: [id])
  challenger    User                   @relation("challengeChallenger", fields: [challengerId], references: [id])
  removedBy     User?                  @relation("challengeContentRemover", fields: [removedById], references: [id])
  transitions   ChallengeTransition[]
  response      ChallengeResponse?

  @@index([reviewVersionId, createdAt])
  @@index([nodeEdgeProposalId, createdAt])
  @@index([canonicalSubjectHash, status])
  @@index([challengerId, createdAt])
}

/// Immutable, one-per-challenge contributor-of-record response. Moderation
/// changes only the tombstone projection; original bytes and digest are retained.
model ChallengeResponse {
  id                             String    @id @default(cuid())
  challengeId                    String    @unique
  responderId                    String
  responderRoleSnapshot          String
  responderGithubLoginSnapshot   String
  responderDisplayNameSnapshot   String?
  contributorPersonId            String?
  nodeContributorUserId          String?
  contributorGithubLoginSnapshot String
  contributorDisplayNameSnapshot String
  contributorRolesJsonSnapshot   String
  body                           String
  contentHash                    String
  /// visible | removed
  contentStatus                  String    @default("visible")
  contentRevision                Int       @default(0)
  removedAt                      DateTime?
  removedById                    String?
  removedByRoleSnapshot          String?
  createdAt                      DateTime  @default(now())

  challenge           Challenge @relation(fields: [challengeId], references: [id])
  responder           User      @relation("challengeResponder", fields: [responderId], references: [id])
  contributorPerson   Person?   @relation(fields: [contributorPersonId], references: [id])
  nodeContributorUser User?     @relation("nodeChallengeContributor", fields: [nodeContributorUserId], references: [id])
  removedBy           User?     @relation("challengeResponseRemover", fields: [removedById], references: [id])

  @@index([responderId, createdAt])
  @@index([nodeContributorUserId])
  @@index([contentStatus, createdAt])
}

/// Append-only challenge lifecycle ledger. The nullable initial fromStatus
/// records attributed filing as the first lifecycle event.
model ChallengeTransition {
  id                                       String    @id @default(cuid())
  challengeId                              String
  fromStatus                               String?
  toStatus                                 String
  actorId                                  String
  actorRoleSnapshot                        String
  rationale                                String?
  /// Immutable public tri-state snapshot; null only on legacy/non-outcome rows.
  conflictOfInterestStatus                 String?
  /// Exceptional direct-self-involvement path. Public DTOs expose login/time, never role snapshots.
  administratorOverride                    Boolean   @default(false)
  administratorOverrideById                String?
  administratorOverrideGithubLoginSnapshot String?
  administratorOverrideAt                  DateTime?
  /// Present only on open -> author-responded; binds that event to ChallengeResponse.
  responseContentHash                      String?
  /// Binds every ledger event to the immutable content filed at revision zero.
  filedContentHash                         String
  revision                                 Int
  createdAt                                DateTime  @default(now())

  challenge Challenge @relation(fields: [challengeId], references: [id])
  actor     User      @relation("challengeTransitionActor", fields: [actorId], references: [id])

  @@unique([challengeId, revision])
  @@index([challengeId, createdAt])
}

/// Platform-owned review marker. This is deliberately separate from the
/// repository-authored TRUST assessment and relation assertions.
model TrustVerification {
  id                   String   @id @default(cuid())
  trustAssessmentId    String   @unique
  /// human-reviewed | adjudicated
  status               String
  reviewerId           String
  reviewerRoleSnapshot String
  rationale            String
  /// SHA-256 over the canonical reviewed subject. Reads fail closed on mismatch.
  assessmentHash       String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  assessment TrustAssessment @relation(fields: [trustAssessmentId], references: [id])
  reviewer   User            @relation("trustReviewer", fields: [reviewerId], references: [id])

  @@index([status])
  @@index([reviewerId])
}

/// Explicit authority grant for a non-editor TRUST adjudicator.
model TrustAdjudicatorDesignation {
  id             String    @id @default(cuid())
  userId         String    @unique
  designatedById String
  active         Boolean   @default(true)
  createdAt      DateTime  @default(now())
  revokedAt      DateTime?

  user         User @relation("designatedAdjudicator", fields: [userId], references: [id])
  designatedBy User @relation("adjudicatorDesignator", fields: [designatedById], references: [id])
}

/// Append-only outcome over one same-protocol, current-head disagreement set.
/// It never edits or replaces any referenced assessment.
model TrustAdjudication {
  id                                       String    @id @default(cuid())
  /// claim-citation | node-relation
  subjectType                              String
  claimEvidenceRelationId                  String?
  nodeEdgeProposalId                       String?
  protocolVersion                          String
  /// disagreement-upheld | assessment-upheld | reassessment-requested
  outcome                                  String
  selectedAssessmentId                     String?
  adjudicatorId                            String
  adjudicatorRoleSnapshot                  String
  adjudicatorGithubLoginSnapshot           String
  rationale                                String
  rationaleHash                            String
  conflictOfInterestStatus                 String    @default("not-provided")
  administratorOverride                    Boolean   @default(false)
  administratorOverrideById                String?
  administratorOverrideGithubLoginSnapshot String?
  administratorOverrideAt                  DateTime?
  disagreementHash                         String    @unique
  outcomeHash                              String
  createdAt                                DateTime  @default(now())

  claimEvidenceRelation ClaimEvidenceRelation?       @relation(fields: [claimEvidenceRelationId], references: [id])
  nodeEdgeProposal      NodeEdgeProposal?            @relation(fields: [nodeEdgeProposalId], references: [id])
  adjudicator           User                         @relation("trustAdjudicator", fields: [adjudicatorId], references: [id])
  references            TrustAdjudicationReference[]
  challenges            Challenge[]                  @relation("challengeAdjudication")

  @@index([claimEvidenceRelationId, protocolVersion, createdAt])
  @@index([nodeEdgeProposalId, protocolVersion, createdAt])
  @@index([adjudicatorId, createdAt])
}

/// Ordered immutable assessment/hash binding for one adjudication.
model TrustAdjudicationReference {
  adjudicationId                String
  position                      Int
  assessmentId                  String
  assessmentHash                String
  trustAssessmentId             String?
  nodeRelationTrustAssessmentId String?

  adjudication                TrustAdjudication            @relation(fields: [adjudicationId], references: [id])
  trustAssessment             TrustAssessment?             @relation(fields: [trustAssessmentId], references: [id])
  nodeRelationTrustAssessment NodeRelationTrustAssessment? @relation(fields: [nodeRelationTrustAssessmentId], references: [id])

  @@id([adjudicationId, position])
  @@unique([adjudicationId, assessmentId])
  @@index([trustAssessmentId])
  @@index([nodeRelationTrustAssessmentId])
}

/// Imported TRUST assessment whose mandatory subject is one exact immutable
/// author node-edge proposal. The proposal survives editorial rejection and
/// links to the confirmed edge when accepted, preserving the imported subject.
model NodeRelationTrustAssessment {
  id                       String    @id @default(cuid())
  nodeEdgeProposalId       String
  protocolVersion          String
  assessorType             String
  assessorId               String?
  assessedAt               DateTime?
  /// Immutable public source snapshot. Repository records missing it import as not-provided.
  conflictOfInterestStatus String    @default("not-provided")

  identityIntegrity             String?
  entailment                    String?
  sourceAccess                  String?
  populationRelevance           String?
  interventionExposureRelevance String?
  outcomeRelevance              String?
  methodologicalSafeguards      String?
  statisticalSafeguards         String?
  replicationConvergence        String?
  conflictDependency            String?

  limitationsJson String  @default("[]")
  evidenceJson    String?
  aggregateScore  Float?
  aggregateMethod String?
  reviewStatus    String  @default("unverified-import")

  /// Exact strict parsed repository record, including the relation subject.
  sourceRecordJson       String
  sourceReviewStatus     String
  sourceAssessorType     String
  sourceAssessorId       String?
  sourceAssessedAt       DateTime?
  sourceEvidenceJson     String?
  sourceAggregateScore   Float?
  sourceAggregateMethod  String?
  sourceRecordHash       String?
  sourceLineageKey       String?
  supersedesAssessmentId String?

  revision  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  proposal               NodeEdgeProposal               @relation(fields: [nodeEdgeProposalId], references: [id])
  verification           NodeRelationTrustVerification?
  supersedes             NodeRelationTrustAssessment?   @relation("NodeRelationTrustAssessmentSupersession", fields: [supersedesAssessmentId], references: [id])
  supersededBy           NodeRelationTrustAssessment[]  @relation("NodeRelationTrustAssessmentSupersession")
  adjudicationReferences TrustAdjudicationReference[]

  @@unique([nodeEdgeProposalId, sourceRecordHash])
  @@index([nodeEdgeProposalId])
  @@index([reviewStatus])
  @@index([nodeEdgeProposalId, sourceLineageKey])
}

/// Platform marker for a node-relation assessment. Kept separate from legacy
/// claim-citation verification so neither subject can exist without its FK.
model NodeRelationTrustVerification {
  id                            String   @id @default(cuid())
  nodeRelationTrustAssessmentId String   @unique
  status                        String
  reviewerId                    String
  reviewerRoleSnapshot          String
  rationale                     String
  assessmentHash                String
  createdAt                     DateTime @default(now())
  updatedAt                     DateTime @updatedAt

  assessment NodeRelationTrustAssessment @relation(fields: [nodeRelationTrustAssessmentId], references: [id])
  reviewer   User                        @relation("nodeRelationTrustReviewer", fields: [reviewerId], references: [id])

  @@index([status])
  @@index([reviewerId])
}

model AgentRun {
  id                  String    @id @default(cuid())
  /// e.g. "discussion-answer", "link-proposal", "llm-extraction"
  agentType           String
  modelProvider       String?
  modelName           String?
  modelVersion        String?
  promptVersion       String?
  promptHash          String?
  packetHash          String?
  inputHash           String?
  inputReferencesJson String?
  outputJson          String?
  /// running | succeeded | failed
  status              String
  startedAt           DateTime  @default(now())
  completedAt         DateTime?
  error               String?
  /// unreviewed | approved | rejected
  humanReviewStatus   String    @default("unreviewed")

  discussionMessages       DiscussionMessage[]
  nodeEdgeProposals        NodeEdgeProposal[]
  synthesisDraft           SynthesisDraft?
  synthesisGenerationClaim SynthesisGenerationRequestClaim?
  productionAssertions     PublicationProductionAssertion[]
  certificationResults     CertificationResult[]
}

/// Private immutable model output awaiting an explicit editorial decision.
model SynthesisDraft {
  id                           String    @id @default(cuid())
  seriesKey                    String
  selectorJson                 String
  selectorHash                 String
  materializationPolicyVersion String
  generationKey                String
  regenerationOrdinal          Int
  parentDraftId                String?
  previousAcceptedDraftId      String?
  previousAcceptedOrdinal      Int?
  agentRunId                   String    @unique
  status                       String    @default("pending")
  revision                     Int       @default(0)
  packetJson                   String
  packetHash                   String
  documentJson                 String
  documentHash                 String
  generationMode               String
  pipelineSoftwareName         String
  pipelineSoftwareId           String
  pipelineSoftwareKind         String
  pipelineSoftwareVersion      String
  provider                     String
  model                        String
  modelVersion                 String
  promptVersion                String
  promptHash                   String
  generatedAt                  DateTime
  acceptedAt                   DateTime?
  acceptedById                 String?
  acceptedByRoleSnapshot       String?
  acceptedByDisplayName        String?
  acceptedByGithubLogin        String?
  decisionRationale            String?
  checklistJson                String?
  checklistVersion             String?
  attributionPolicyVersion     String
  rightsStatement              String?
  licenseSpdx                  String?
  versionDoi                   String?
  conceptDoi                   String?
  reviewId                     String?
  requestKey                   String    @unique
  createdAt                    DateTime  @default(now())
  updatedAt                    DateTime  @updatedAt

  agentRun               AgentRun                         @relation(fields: [agentRunId], references: [id])
  parentDraft            SynthesisDraft?                  @relation("synthesisDraftParent", fields: [parentDraftId], references: [id])
  childDrafts            SynthesisDraft[]                 @relation("synthesisDraftParent")
  previousAcceptedDraft  SynthesisDraft?                  @relation("synthesisAcceptedPredecessor", fields: [previousAcceptedDraftId], references: [id])
  acceptedSuccessors     SynthesisDraft[]                 @relation("synthesisAcceptedPredecessor")
  acceptedBy             User?                            @relation("synthesisDraftApprover", fields: [acceptedById], references: [id])
  review                 Review?                          @relation(fields: [reviewId], references: [id])
  reviewVersion          ReviewVersion?
  memberships            SynthesisDraftMembership[]
  citations              SynthesisDraftCitation[]
  generationRequestClaim SynthesisGenerationRequestClaim?
  stalenessEvaluations   SynthesisStalenessEvaluation[]

  @@unique([seriesKey, regenerationOrdinal])
  @@unique([generationKey, regenerationOrdinal])
  @@index([status, createdAt])
  @@index([seriesKey, status])
}

/// Durable pre-provider ownership claim. A request key is permanently bound to
/// one canonical selector so retries cannot create orphan or duplicate runs.
model SynthesisGenerationRequestClaim {
  key            String    @id
  requestKey     String    @unique
  selectorJson   String
  selectorHash   String
  status         String    @default("running")
  leaseToken     String?
  leaseExpiresAt DateTime?
  attempt        Int       @default(1)
  draftId        String?   @unique
  agentRunId     String?   @unique
  errorCode      String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  draft    SynthesisDraft? @relation(fields: [draftId], references: [id])
  agentRun AgentRun?       @relation(fields: [agentRunId], references: [id])

  @@index([status, updatedAt])
}

model SynthesisDraftMembership {
  draftId          String
  referenceId      String
  kind             String
  nodeId           String
  nodeVersionId    String
  identifierScheme String?
  identifierRole   String?
  identifierValue  String?
  position         Int

  draft       SynthesisDraft       @relation(fields: [draftId], references: [id])
  node        KnowledgeNode        @relation(fields: [nodeId], references: [id])
  nodeVersion KnowledgeNodeVersion @relation(fields: [nodeVersionId], references: [id])

  @@id([draftId, referenceId])
  @@unique([draftId, position])
  @@index([nodeId, nodeVersionId])
  @@index([referenceId])
}

model SynthesisDraftCitation {
  id               String  @id @default(cuid())
  draftId          String
  occurrenceKey    String
  location         String
  sectionId        String?
  paragraphIndex   Int?
  citationIndex    Int
  referenceId      String
  nodeId           String
  nodeVersionId    String
  nodeKind         String
  nodeTitle        String
  identifierScheme String?
  identifierRole   String?
  identifierValue  String?

  draft       SynthesisDraft       @relation(fields: [draftId], references: [id])
  node        KnowledgeNode        @relation(fields: [nodeId], references: [id])
  nodeVersion KnowledgeNodeVersion @relation(fields: [nodeVersionId], references: [id])

  @@unique([draftId, occurrenceKey])
  @@index([draftId, referenceId])
  @@index([nodeId, nodeVersionId])
}

/// Public attribution principals for synthesis versions; software is never a Person/User.
model SynthesisAttributionContributor {
  reviewVersionId     String
  position            Int
  kind                String
  displayName         String
  role                String
  softwareVersion     String?
  userId              String?
  userRoleSnapshot    String?
  githubLoginSnapshot String?

  reviewVersion ReviewVersion @relation(fields: [reviewVersionId], references: [id])
  user          User?         @relation("synthesisAttributionUser", fields: [userId], references: [id])

  @@id([reviewVersionId, position])
  @@index([userId])
}

/// Immutable, bounded comparison of one accepted synthesis head against the
/// current materialization of its exact stored selector.
model SynthesisStalenessEvaluation {
  id                                    String   @id @default(cuid())
  evaluationKey                         String   @unique
  policyVersion                         String
  reviewId                              String
  acceptedReviewVersionId               String
  acceptedDraftId                       String
  seriesKey                             String
  selectorJson                          String
  selectorHash                          String
  acceptedMaterializationPolicyVersion  String
  evaluatedMaterializationPolicyVersion String
  acceptedPacketHash                    String
  acceptedPacketJson                    String
  evaluatedPacketHash                   String?
  evaluatedPacketJson                   String?
  failureCode                           String?
  failureFingerprint                    String?
  status                                String
  reasonCodesJson                       String
  affectedReferencesJson                String
  affectedReferenceCount                Int
  affectedReferencesTruncated           Boolean  @default(false)
  evaluatedAt                           DateTime @default(now())

  review                Review                          @relation(fields: [reviewId], references: [id])
  acceptedReviewVersion ReviewVersion                   @relation("synthesisStalenessVersion", fields: [acceptedReviewVersionId], references: [id])
  acceptedDraft         SynthesisDraft                  @relation(fields: [acceptedDraftId], references: [id])
  currentForHeads       SynthesisStalenessHead[]        @relation("currentSynthesisStalenessEvaluation")
  proposals             SynthesisRegenerationProposal[]

  @@index([acceptedReviewVersionId, evaluatedAt])
  @@index([reviewId, evaluatedAt])
}

/// Authoritative freshness observation for one immutable accepted head. The
/// evaluation may point back to a previously seen A state after A→B→A.
model SynthesisStalenessHead {
  acceptedReviewVersionId String   @id
  reviewId                String
  currentEvaluationId     String
  revision                Int      @default(0)
  observedAt              DateTime @default(now())

  review            Review                       @relation(fields: [reviewId], references: [id])
  acceptedVersion   ReviewVersion                @relation(fields: [acceptedReviewVersionId], references: [id])
  currentEvaluation SynthesisStalenessEvaluation @relation("currentSynthesisStalenessEvaluation", fields: [currentEvaluationId], references: [id])

  @@index([reviewId])
  @@index([currentEvaluationId])
}

/// Private editorial proposal only. A nullable unique head key guarantees at
/// most one open proposal per accepted head on SQLite and PostgreSQL.
model SynthesisRegenerationProposal {
  id                       String    @id @default(cuid())
  evaluationId             String
  reviewId                 String
  acceptedReviewVersionId  String
  openHeadKey              String?   @unique
  status                   String    @default("open")
  revision                 Int       @default(0)
  resolvedById             String?
  resolvedAt               DateTime?
  resolutionRationale      String?
  resolutionIdempotencyKey String?
  resolutionInputHash      String?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  evaluation            SynthesisStalenessEvaluation @relation(fields: [evaluationId], references: [id])
  review                Review                       @relation(fields: [reviewId], references: [id])
  acceptedReviewVersion ReviewVersion                @relation("synthesisRegenerationVersion", fields: [acceptedReviewVersionId], references: [id])
  resolvedBy            User?                        @relation("synthesisRegenerationResolver", fields: [resolvedById], references: [id])

  @@index([status, createdAt])
  @@index([reviewId, status])
  @@index([evaluationId])
}

model DiscussionThread {
  id        String   @id @default(cuid())
  userId    String?
  title     String
  /// JSON: review slugs / filters bounding the thread.
  scopeJson String   @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User?               @relation(fields: [userId], references: [id])
  messages DiscussionMessage[]
}

model DiscussionMessage {
  id                String   @id @default(cuid())
  threadId          String
  /// user | assistant
  role              String
  content           String
  /// Evidence packet reference + grounding validation result.
  groundingJson     String?
  modelMetadataJson String?
  agentRunId        String?
  createdAt         DateTime @default(now())

  thread   DiscussionThread @relation(fields: [threadId], references: [id])
  agentRun AgentRun?        @relation(fields: [agentRunId], references: [id])
}

/// Human peer commentary on a published review — the scholarly exchange layer.
/// Distinct from DiscussionThread/Message, which persist AI-grounded Q&A.
/// Bodies are plain text only and always rendered escaped (never raw HTML).
model ReviewComment {
  id                 String    @id @default(cuid())
  reviewId           String
  /// Immutable review version this comment was made against. Nullable only
  /// for legacy rows created before version-scoped discussion.
  reviewVersionId    String?
  authorId           String
  /// Top-level comment when null; threads are one level deep (replies).
  parentId           String?
  /// Optional claim this comment is anchored to (claim-level commentary).
  claimId            String?
  /// Repository-relative MyST page for an exact passage annotation.
  targetDocumentPath String?
  /// Canonical contracts passageCommentAnchorSchema JSON. Immutable after creation.
  targetSelectorJson String?
  /// SHA-256 of targetSelectorJson for stable machine identity and deduplication.
  targetSelectorHash String?
  /// contracts COMMENT_KINDS: comment | question | concern | suggestion | endorsement
  kind               String    @default("comment")
  body               String
  /// contracts COMMENT_STATUSES: visible | removed
  status             String    @default("visible")
  /// User id of the remover (author or editor); no FK to keep moderation light.
  removedById        String?
  removedAt          DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  review        Review          @relation(fields: [reviewId], references: [id])
  reviewVersion ReviewVersion?  @relation(fields: [reviewVersionId], references: [id])
  author        User            @relation(fields: [authorId], references: [id])
  parent        ReviewComment?  @relation("replies", fields: [parentId], references: [id])
  replies       ReviewComment[] @relation("replies")
  claim         Claim?          @relation(fields: [claimId], references: [id])

  @@index([reviewId, createdAt])
  @@index([reviewVersionId, createdAt])
  @@index([reviewVersionId, targetDocumentPath, createdAt])
}

/// Conservative automated cross-review link proposals (spec §15).
model KnowledgeLinkProposal {
  id                 String    @id @default(cuid())
  sourceClaimId      String
  targetClaimId      String
  /// contracts LINK_PROPOSAL_TYPES
  proposedRelation   String
  /// Deterministic features that produced the proposal (shared DOIs, token overlap...).
  featuresJson       String
  semanticSimilarity Float?
  rationale          String
  /// Provenance: agent run / extractor version.
  agentProvenance    String
  /// proposed | accepted | rejected | superseded
  status             String    @default("proposed")
  reviewedById       String?
  reviewedAt         DateTime?
  createdAt          DateTime  @default(now())

  sourceClaim Claim @relation("sourceClaim", fields: [sourceClaimId], references: [id])
  targetClaim Claim @relation("targetClaim", fields: [targetClaimId], references: [id])

  @@unique([sourceClaimId, targetClaimId, proposedRelation])
}

/// Append-only audit trail for editorially meaningful changes.
model AuditEvent {
  id              String   @id @default(cuid())
  actorId         String?
  /// e.g. submission.finalized, submission.accepted, review.published,
  /// trust.adjudicated, linkProposal.reviewed, auth.mock-login-refused
  action          String
  subjectType     String
  subjectId       String
  detailsJson     String   @default("{}")
  /// Optional deterministic key for retry-safe transactional events.
  idempotencyKey  String?
  /// ORAtlas platform release that emitted this event. Null only on historical rows.
  platformVersion String?
  createdAt       DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id])

  @@index([subjectType, subjectId])
  @@index([idempotencyKey])
}

/// Database-enforced operation claim used before retry-safe audit writes.
/// A new table keeps populated upgrades safe without adding a unique index
/// over a legacy nullable column.
model IdempotencyKey {
  key         String   @id
  requestHash String?
  createdAt   DateTime @default(now())
}

/// Editor responsible for a submission, with an explicit conflict-of-interest
/// declaration. A declared conflict forces immediate recusal; an editor can
/// never be assigned to their own submission.
model EditorAssignment {
  id           String   @id @default(cuid())
  submissionId String
  editorId     String
  assignedById String
  /// contracts EDITOR_ASSIGNMENT_STATUSES: active | recused | completed
  status       String   @default("active")
  coiDeclared  Boolean  @default(false)
  coiStatement String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  submission Submission @relation(fields: [submissionId], references: [id])
  editor     User       @relation("assignmentEditor", fields: [editorId], references: [id])
  assignedBy User       @relation("assignmentAssigner", fields: [assignedById], references: [id])

  @@unique([submissionId, editorId])
}

/// Numbered formal review round on a submission. Rounds are append-only and
/// close exactly once with a decision letter.
model ReviewRound {
  id           String    @id @default(cuid())
  submissionId String
  roundNumber  Int
  /// contracts REVIEW_ROUND_STATUSES: open | decided
  status       String    @default("open")
  openedById   String
  openedAt     DateTime  @default(now())
  decidedAt    DateTime?

  submission     Submission           @relation(fields: [submissionId], references: [id])
  openedBy       User                 @relation("roundOpener", fields: [openedById], references: [id])
  reports        FormalReviewReport[]
  responses      AuthorResponse[]
  decisionLetter DecisionLetter?

  @@unique([submissionId, roundNumber])
}

/// Immutable, attributable formal peer-review report. One report per
/// reviewer per round; there is no update or delete path.
model FormalReviewReport {
  id                    String   @id @default(cuid())
  roundId               String
  reviewerId            String
  /// Reviewer ORCID snapshot at submission time (contracts orcidSchema).
  reviewerOrcid         String?
  reviewerOrcidVerified Boolean  @default(false)
  /// contracts REVIEW_RECOMMENDATIONS
  recommendation        String
  /// Canonical JSON of contracts formalReviewReportBodySchema.
  bodyJson              String
  /// SHA-256 of bodyJson (integrity of the immutable report).
  bodyHash              String
  coiStatement          String?
  submittedAt           DateTime @default(now())

  round    ReviewRound @relation(fields: [roundId], references: [id])
  reviewer User        @relation("formalReviewer", fields: [reviewerId], references: [id])

  @@unique([roundId, reviewerId])
}

/// Author response within a review round; append-only and attributable.
model AuthorResponse {
  id          String   @id @default(cuid())
  roundId     String
  authorId    String
  /// Canonical JSON of contracts authorResponseBodySchema.
  bodyJson    String
  bodyHash    String
  submittedAt DateTime @default(now())

  round  ReviewRound @relation(fields: [roundId], references: [id])
  author User        @relation("respondingAuthor", fields: [authorId], references: [id])
}

/// Decision letter closing a round. Exactly one per round; immutable.
model DecisionLetter {
  id                                       String    @id @default(cuid())
  roundId                                  String    @unique
  editorId                                 String
  /// Immutable public actor identity; null only on legacy rows.
  editorGithubLoginSnapshot                String?
  editorRoleSnapshot                       String?
  /// contracts ROUND_DECISIONS: accept | reject | request-changes
  decision                                 String
  /// Canonical JSON of contracts decisionLetterBodySchema.
  bodyJson                                 String
  bodyHash                                 String
  /// SHA-256 over decision, body hash, public COI snapshot and public override provenance.
  decisionHash                             String?
  /// Immutable public tri-state snapshot for the decision itself.
  conflictOfInterestStatus                 String    @default("not-provided")
  administratorOverride                    Boolean   @default(false)
  administratorOverrideById                String?
  administratorOverrideGithubLoginSnapshot String?
  administratorOverrideAt                  DateTime?
  createdAt                                DateTime  @default(now())

  round  ReviewRound @relation(fields: [roundId], references: [id])
  editor User        @relation("decisionEditor", fields: [editorId], references: [id])
}

/// In-app notification for editorial lifecycle events.
model Notification {
  id          String    @id @default(cuid())
  userId      String
  /// contracts NOTIFICATION_KINDS
  kind        String
  subjectType String
  subjectId   String
  payloadJson String    @default("{}")
  readAt      DateTime?
  createdAt   DateTime  @default(now())

  user User @relation("notificationUser", fields: [userId], references: [id])

  @@index([userId, readAt])
}

/// Externally observed change to a cited work (retraction, correction,
/// expression of concern, new evidence). Signals are append-only.
model CitationStatusRecord {
  id           String   @id @default(cuid())
  /// Canonical work alias (contracts canonicalWorkAliases form, e.g. doi:10.x/y).
  workAlias    String
  /// contracts CITATION_STATUSES
  status       String
  /// Where the signal came from (registry, publisher notice, manual review).
  source       String
  evidenceUrl  String?
  note         String?
  recordedById String?
  recordedAt   DateTime @default(now())

  recordedBy User?                 @relation("statusRecorder", fields: [recordedById], references: [id])
  proposals  ClaimUpdateProposal[]

  @@index([workAlias])
}

/// Human-reviewable update proposal opened when a status signal affects a
/// claim. Conclusions are never rewritten automatically; an editor resolves
/// each proposal with an attributable note.
model ClaimUpdateProposal {
  id             String    @id @default(cuid())
  statusRecordId String
  claimId        String
  citationId     String
  /// contracts PROPOSAL_STATUSES
  status         String    @default("open")
  /// Deterministic description of why this claim is affected.
  rationale      String
  resolvedById   String?
  resolutionNote String?
  createdAt      DateTime  @default(now())
  resolvedAt     DateTime?

  statusRecord CitationStatusRecord @relation(fields: [statusRecordId], references: [id])
  claim        Claim                @relation(fields: [claimId], references: [id])
  citation     Citation             @relation(fields: [citationId], references: [id])
  resolvedBy   User?                @relation("proposalResolver", fields: [resolvedById], references: [id])

  @@unique([statusRecordId, claimId])
  @@index([status])
}

/// COAR Notify review activities received from or prepared for external
/// repository services. Payloads are immutable canonical JSON; an editor may
/// accept or reject an inbound request, but never rewrite the received bytes.
model FederationNotification {
  id              String    @id @default(cuid())
  activityId      String    @unique
  /// inbound | outbound
  direction       String
  /// request-review | announce-review
  pattern         String
  /// pending | accepted | rejected | prepared | delivered
  status          String    @default("pending")
  actorUri        String?
  objectUri       String
  contextUri      String?
  originUri       String
  originInbox     String?
  targetUri       String
  targetInbox     String
  inReplyTo       String?
  payloadJson     String
  payloadHash     String
  reviewVersionId String?
  resolvedById    String?
  resolutionNote  String?
  createdAt       DateTime  @default(now())
  resolvedAt      DateTime?

  reviewVersion ReviewVersion? @relation(fields: [reviewVersionId], references: [id])
  resolvedBy    User?          @relation("federationResolver", fields: [resolvedById], references: [id])

  @@index([direction, status, createdAt])
  @@index([reviewVersionId])
  @@index([inReplyTo])
}

/// Immutable registry payload plus its deterministic normalized representation.
/// The primary key is a SHA-256-derived stable id over the exact target, source
/// version and payload hash, making retries idempotent across SQLite/PostgreSQL.
model ProtocolSnapshot {
  id                   String    @id
  reviewVersionId      String
  claimId              String?
  createdById          String
  /// review-version:<id> or claim:<id>; explicit because nullable unique keys
  /// behave differently between providers.
  targetKey            String
  /// osf | clinicaltrials-gov
  registry             String
  sourceId             String
  sourceUrl            String
  sourceVersion        String
  sourceTimestamp      DateTime?
  fetchedAt            DateTime
  normalizedJson       String
  rawJson              String
  questionMetadataJson String?
  contentHash          String
  observedJson         String
  comparatorVersion    String
  createdAt            DateTime  @default(now())

  reviewVersion ReviewVersion           @relation(fields: [reviewVersionId], references: [id])
  claim         Claim?                  @relation(fields: [claimId], references: [id])
  createdBy     User                    @relation("protocolSnapshotCreator", fields: [createdById], references: [id])
  proposals     ProtocolDriftProposal[]

  @@unique([targetKey, registry, sourceId, sourceVersion])
  @@index([reviewVersionId, createdAt])
  @@index([claimId, createdAt])
  @@index([registry, sourceId])
}

/// Neutral, human-reviewable reconciliation proposal. It never asserts intent
/// or rewrites review content. Stable comparison ids make creation retry-safe.
model ProtocolDriftProposal {
  id                String    @id
  snapshotId        String
  /// population | outcomes | exclusions | analysis-plan
  category          String
  /// not-described-in-review | not-registered | content-differs
  kind              String
  registeredJson    String
  observedJson      String
  rationale         String
  comparatorVersion String
  /// open | confirmed-update-needed | explained | dismissed
  status            String    @default("open")
  resolvedById      String?
  resolutionNote    String?
  resolvedAt        DateTime?
  createdAt         DateTime  @default(now())

  snapshot   ProtocolSnapshot @relation(fields: [snapshotId], references: [id])
  resolvedBy User?            @relation("protocolProposalResolver", fields: [resolvedById], references: [id])

  @@index([snapshotId, status])
  @@index([status, createdAt])
}

// ---------------------------------------------------------------------------
// Generic publication boundary (docs/external-publications.md).
//
// A Review is one TYPE of publication, not the federation object. These models
// are the boundary an independently hosted publication is observed through and
// that legacy review storage projects into. They are deliberately separate
// from KnowledgeNode: a source occurrence is never canonical graph identity.
// ---------------------------------------------------------------------------

/// Stable identity of one source publication across its versions. Never an
/// ORAtlas canonical graph node, and never keyed by a URL alone.
model Publication {
  id                       String   @id @default(cuid())
  /// Global federation key derived from durable identity evidence only.
  stableKey                String   @unique
  /// contracts PUBLICATION_TYPES: review-article | research-article |
  /// methods-article | preprint | living-review | other.
  publicationType          String
  /// contracts PUBLICATION_RECORD_SOURCES:
  /// external-publication | atlas-review-projection.
  recordSource             String
  /// contracts publicationIdentityEvidenceSchema encoded as JSON. Retained so
  /// the keying decision stays auditable and is never re-derived from a URL.
  identityEvidenceJson     String
  /// Author-declared identifier, stable across versions. Evidence, not identity.
  sourceLocalPublicationId String?
  /// Legacy projection binding. Exactly one publication may project one review.
  reviewId                 String?  @unique
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  review            Review?               @relation("reviewPublicationProjection", fields: [reviewId], references: [id], onDelete: Restrict)
  versions          PublicationVersion[]
  outgoingRelations PublicationRelation[] @relation("publicationRelationSource")
  incomingRelations PublicationRelation[] @relation("publicationRelationTarget")

  @@index([publicationType])
  @@index([recordSource])
}

/// One exact, immutable, externally observed publication version. Identity is
/// (publication, sourcesSha256); the canonical URL is addressing metadata.
model PublicationVersion {
  id                         String   @id @default(cuid())
  publicationId              String
  /// Exact version key derived from the publication identity plus sourcesSha256.
  stableKey                  String   @unique
  /// Source-local publication id as observed on this exact version.
  sourceLocalPublicationId   String?
  /// The publication's own digest over its complete document set.
  sourcesSha256              String
  versionLabel               String?
  title                      String?
  /// Publisher-declared absolute https canonical URL, when one was declared.
  /// Optional protocol metadata; ORAtlas never fabricates it.
  canonicalUrl               String?
  /// Deterministic directory URL derived from the observed publication-manifest
  /// final URL (or requested URL when no final URL was retained). Never copied
  /// into canonicalUrl and nullable only for pre-Phase-3 captured rows.
  observedPublicationBaseUrl String?
  /// contracts PUBLICATION_ADAPTER_TYPES. Generic; toolchain fields never leak
  /// into their own columns.
  adapterType                String
  /// contracts publicationAdapterBindingSchema encoded as JSON: closed,
  /// discriminated and carrying its own pinned external protocol version.
  adapterBindingJson         String
  /// contracts publicationSourceDescriptorSchema encoded as JSON. Null when the
  /// publication declares no obtainable source, which caps structural
  /// provenance at published-structure.
  sourceDescriptorJson       String?
  /// contracts PUBLICATION_STRUCTURAL_PROVENANCE_LEVELS. Structural only:
  /// published-structure | source-byte. Never a scientific validation state.
  structuralProvenance       String
  /// Recorded reasons a declared source did not reach source-byte provenance.
  verificationWarningsJson   String   @default("[]")
  /// Canonical JSON array of deterministic plain-text content documents.
  /// Persisted on this immutable version so later extractor changes cannot
  /// rewrite the representation supplied to certification.
  contentCorpusJson          String   @default("[]")
  /// SHA-256 of contentCorpusJson.
  contentCorpusSha256        String   @default("4f53cda18c2baa0c0354bb5f9a3ecbe5ed12ab4d8e11ba873c2f11161202b945")
  /// Canonical publicationContentCompletenessSchema JSON.
  contentCompletenessJson    String   @default("{\"coverage\":\"unsupported\",\"returnedDocuments\":0,\"totalDocumentsKnown\":null,\"truncated\":false}")
  /// True only when the adapter supplied an exact-version contributor snapshot,
  /// including an explicitly declared empty snapshot. Never inferred.
  contributorsDeclared       Boolean  @default(false)
  observedAt                 DateTime
  createdAt                  DateTime @default(now())

  publication          Publication                      @relation(fields: [publicationId], references: [id], onDelete: Restrict)
  captures             PublicationCapture[]
  claimOccurrences     PublicationClaimOccurrence[]
  contributors         PublicationVersionContributor[]
  productionAssertions PublicationProductionAssertion[]
  certificationRuns    CertificationRun[]
  certificationResults CertificationResult[]

  /// Distinct publications may legitimately share a sourcesSha256, so exact
  /// version identity is scoped to its publication rather than global.
  @@unique([publicationId, sourcesSha256])
  @@index([publicationId])
  @@index([structuralProvenance])
}

/// Immutable, source-declared scholarly-credit metadata for one exact
/// publication version. This has no Person relation: declared names and
/// identifiers are retained metadata, never ORAtlas identity assertions.
model PublicationVersionContributor {
  id                              String   @id @default(cuid())
  publicationVersionId            String
  sourceContributorKey            String
  /// person | organization.
  kind                            String
  displayName                     String
  givenName                       String?
  familyName                      String?
  /// Canonical JSON arrays using the bounded contributor contracts.
  identifiersJson                 String   @default("[]")
  affiliationsJson                String   @default("[]")
  rolesJson                       String
  /// One-based source-declared order within this exact version.
  position                        Int
  publicUrl                       String?
  /// Canonical publicationContributorSourceDeclarationProvenanceSchema JSON.
  sourceDeclarationProvenanceJson String
  createdAt                       DateTime @default(now())

  publicationVersion PublicationVersion @relation(fields: [publicationVersionId], references: [id], onDelete: Restrict)

  @@unique([publicationVersionId, sourceContributorKey])
  @@unique([publicationVersionId, position])
  @@index([publicationVersionId, position])
}

/// Accountable organization which owns immutable certification protocols.
/// Certification results are attributed assertions, never global truth state.
model Certifier {
  id            String    @id @default(cuid())
  slug          String    @unique
  name          String
  description   String
  publicUrl     String?
  governanceUrl String?
  publicContact String?
  /// active | suspended | retired
  status        String    @default("active")
  createdById   String
  createdAt     DateTime  @default(now())
  activatedAt   DateTime?
  retiredAt     DateTime?

  createdBy       User                          @relation("certifierCreator", fields: [createdById], references: [id], onDelete: Restrict)
  protocols       CertificationProtocol[]
  credentials     CertifierCredential[]
  runs            CertificationRun[]
  results         CertificationResult[]
  lifecycleEvents CertificationLifecycleEvent[]

  @@index([status, name])
}

/// One exact immutable version of a certifier-owned protocol.
model CertificationProtocol {
  id                   String   @id @default(cuid())
  certifierId          String
  seriesKey            String
  protocolVersion      String
  title                String
  description          String
  protocolJson         String
  protocolSha256       String
  /// active | retired
  status               String   @default("active")
  supersedesProtocolId String?  @unique
  createdAt            DateTime @default(now())

  certifier    Certifier              @relation(fields: [certifierId], references: [id], onDelete: Restrict)
  supersedes   CertificationProtocol? @relation("CertificationProtocolSupersession", fields: [supersedesProtocolId], references: [id], onDelete: Restrict)
  supersededBy CertificationProtocol? @relation("CertificationProtocolSupersession")
  runs         CertificationRun[]
  results      CertificationResult[]

  @@unique([certifierId, seriesKey, protocolVersion])
  @@index([certifierId, status])
}

/// Scoped machine credential. The secret is displayed once; only its digest is retained.
model CertifierCredential {
  id          String    @id @default(cuid())
  certifierId String
  label       String
  tokenPrefix String    @unique
  tokenHash   String    @unique
  scopesJson  String
  expiresAt   DateTime?
  revokedAt   DateTime?
  issuedById  String
  revokedById String?
  createdAt   DateTime  @default(now())
  lastUsedAt  DateTime?

  certifier Certifier @relation(fields: [certifierId], references: [id], onDelete: Restrict)
  issuedBy  User      @relation("credentialIssuer", fields: [issuedById], references: [id], onDelete: Restrict)
  revokedBy User?     @relation("credentialRevoker", fields: [revokedById], references: [id], onDelete: Restrict)

  @@index([certifierId, revokedAt])
}

/// One exact certification execution with an immutable captured packet input.
model CertificationRun {
  id                   String    @id @default(cuid())
  publicationVersionId String
  certifierId          String
  protocolId           String
  assessmentMode       String
  /// requested | running | completed | failed | cancelled
  status               String    @default("requested")
  requestedById        String?
  externalRunReference String?
  idempotencyKey       String
  inputPacketJson      String
  inputPacketSha256    String
  packetSchemaVersion  String
  completenessJson     String
  capturedAt           DateTime
  startedAt            DateTime?
  completedAt          DateTime?
  /// Immutable explanation for an owner-requested failed/cancelled terminal transition.
  terminalReason       String?
  createdAt            DateTime  @default(now())

  publicationVersion PublicationVersion    @relation(fields: [publicationVersionId], references: [id], onDelete: Restrict)
  certifier          Certifier             @relation(fields: [certifierId], references: [id], onDelete: Restrict)
  protocol           CertificationProtocol @relation(fields: [protocolId], references: [id], onDelete: Restrict)
  requestedBy        User?                 @relation("certificationRunRequester", fields: [requestedById], references: [id], onDelete: Restrict)
  result             CertificationResult?

  @@unique([certifierId, idempotencyKey])
  @@index([publicationVersionId, createdAt])
  @@index([protocolId, status])
}

/// Immutable attributed certification assertion for one exact run and subject.
model CertificationResult {
  id                     String   @id @default(cuid())
  certificationRunId     String   @unique
  publicationVersionId   String
  certifierId            String
  protocolId             String
  inputPacketSha256      String
  assessmentMode         String
  criteriaJson           String
  outcome                String
  limitationsJson        String
  conflictOfInterestJson String
  independenceJson       String
  provenanceJson         String
  resultJson             String
  resultSha256           String
  agentRunId             String?
  executionPassportId    String?
  supersedesResultId     String?  @unique
  issuedAt               DateTime
  createdAt              DateTime @default(now())

  run                CertificationRun              @relation(fields: [certificationRunId], references: [id], onDelete: Restrict)
  publicationVersion PublicationVersion            @relation(fields: [publicationVersionId], references: [id], onDelete: Restrict)
  certifier          Certifier                     @relation(fields: [certifierId], references: [id], onDelete: Restrict)
  protocol           CertificationProtocol         @relation(fields: [protocolId], references: [id], onDelete: Restrict)
  agentRun           AgentRun?                     @relation(fields: [agentRunId], references: [id], onDelete: Restrict)
  executionPassport  ExecutionPassport?            @relation(fields: [executionPassportId], references: [id], onDelete: Restrict)
  supersedes         CertificationResult?          @relation("CertificationResultSupersession", fields: [supersedesResultId], references: [id], onDelete: Restrict)
  supersededBy       CertificationResult?          @relation("CertificationResultSupersession")
  lifecycleEvents    CertificationLifecycleEvent[]

  @@index([publicationVersionId, issuedAt])
  @@index([certifierId, issuedAt])
}

/// Append-only result lifecycle; the immutable assertion is never rewritten or deleted.
model CertificationLifecycleEvent {
  id               String   @id @default(cuid())
  resultId         String
  /// issued | superseded | withdrawn | revoked
  kind             String
  reason           String?
  actorUserId      String?
  actorCertifierId String?
  createdAt        DateTime @default(now())

  result         CertificationResult @relation(fields: [resultId], references: [id], onDelete: Restrict)
  actorUser      User?               @relation("certificationLifecycleActor", fields: [actorUserId], references: [id], onDelete: Restrict)
  actorCertifier Certifier?          @relation(fields: [actorCertifierId], references: [id], onDelete: Restrict)

  @@unique([resultId, kind])
  @@index([resultId, createdAt])
}

/// Optional append-only declaration of how one exact publication version was
/// produced. Production actors are not scholarly contributors, and neither
/// the mode nor its evidence says anything about scientific merit.
model PublicationProductionAssertion {
  id                    String   @id @default(cuid())
  publicationVersionId  String
  /// Adapter-supplied stable key for source declarations; null for editorial
  /// ORAtlas attestations.
  sourceAssertionKey    String?
  /// contracts PUBLICATION_PRODUCTION_MODES.
  mode                  String
  /// Canonical JSON arrays using the bounded production actor/activity schemas.
  actorsJson            String   @default("[]")
  activitiesJson        String   @default("[]")
  statement             String?
  /// source-declared | oratlas-attested.
  strength              String
  publicEvidenceUrl     String?
  agentRunId            String?
  executionPassportId   String?
  /// Corrections are new immutable assertions pointing at the assertion they
  /// replace. The prior row is never rewritten.
  supersedesAssertionId String?  @unique
  assertedById          String?
  assertedAt            DateTime
  createdAt             DateTime @default(now())

  publicationVersion PublicationVersion              @relation(fields: [publicationVersionId], references: [id], onDelete: Restrict)
  agentRun           AgentRun?                       @relation(fields: [agentRunId], references: [id], onDelete: Restrict)
  executionPassport  ExecutionPassport?              @relation(fields: [executionPassportId], references: [id], onDelete: Restrict)
  assertedBy         User?                           @relation("productionAssertionActor", fields: [assertedById], references: [id], onDelete: Restrict)
  supersedes         PublicationProductionAssertion? @relation("productionAssertionSupersession", fields: [supersedesAssertionId], references: [id], onDelete: Restrict)
  supersededBy       PublicationProductionAssertion? @relation("productionAssertionSupersession")

  @@unique([publicationVersionId, sourceAssertionKey])
  @@index([publicationVersionId, assertedAt])
  @@index([agentRunId])
  @@index([executionPassportId])
}

/// Explicit reviewed provenance/transfer relationship between two publication
/// identities. It records a decision; it never merges either publication.
model PublicationRelation {
  id                  String   @id @default(cuid())
  sourcePublicationId String
  targetPublicationId String
  /// contracts PUBLICATION_RELATION_TYPES.
  relationType        String
  rationale           String
  publicEvidenceUrl   String?
  reviewedById        String
  reviewedAt          DateTime
  createdAt           DateTime @default(now())

  sourcePublication Publication @relation("publicationRelationSource", fields: [sourcePublicationId], references: [id], onDelete: Restrict)
  targetPublication Publication @relation("publicationRelationTarget", fields: [targetPublicationId], references: [id], onDelete: Restrict)
  reviewedBy        User        @relation("publicationRelationReviewer", fields: [reviewedById], references: [id], onDelete: Restrict)

  @@unique([sourcePublicationId, targetPublicationId, relationType])
  @@index([sourcePublicationId, reviewedAt])
  @@index([targetPublicationId, reviewedAt])
}

/// Immutable record of exactly what ORAtlas observed for one artifact of one
/// publication version. Append-only at the database layer: observed bytes and
/// digests can never be silently rewritten.
model PublicationCapture {
  id                     String   @id @default(cuid())
  publicationVersionId   String
  /// contracts PUBLICATION_CAPTURE_ARTIFACT_KINDS.
  artifactKind           String
  /// SHA-256 over the artifact kind and its declared path (or request URL for
  /// the root manifest). This identifies the artifact slot independently of
  /// its bytes, so equal content at distinct paths remains distinct.
  artifactIdentitySha256 String
  /// Publication-relative path the artifact was declared at, re-validated
  /// against the safe-path rule before it was ever resolved.
  declaredPath           String?
  /// Absolute location the bytes were observed at, when one exists.
  observedUrl            String?
  /// Absolute URL requested before redirects, retained independently.
  requestedUrl           String?
  mediaType              String
  /// SHA-256 over the exact observed bytes. Always recomputed, never copied.
  contentSha256          String
  byteLength             Int
  /// Exact observed bytes. Nullable so a later phase can retain the digest
  /// alone for an artifact too large to store inline.
  contentBytes           String?
  /// Digest the publication declared for this artifact, retained separately
  /// from the digest ORAtlas computed.
  declaredSha256         String?
  /// Canonical JSON of selected response headers, status, and redirect chain.
  httpProvenanceJson     String   @default("{}")
  /// contracts PUBLICATION_STRUCTURAL_PROVENANCE_LEVELS reached by this capture.
  structuralProvenance   String
  capturedAt             DateTime
  createdAt              DateTime @default(now())

  publicationVersion PublicationVersion @relation(fields: [publicationVersionId], references: [id], onDelete: Restrict)

  @@unique([publicationVersionId, artifactIdentitySha256])
  @@index([publicationVersionId])
  @@index([contentSha256])
}

/// One exact occurrence of a claim declaration in one publication version.
///
/// This is not a canonical claim identity. ORAtlas must never infer that two
/// occurrences are the same claim from equal text, an equal source-local id in
/// different versions, an equal declarationSha256, an equal sourcesSha256,
/// position, ordering or similarity.
model PublicationClaimOccurrence {
  id                   String   @id @default(cuid())
  publicationVersionId String
  /// Author-chosen id, unique only inside one publication version.
  sourceLocalClaimId   String
  /// Atlas-derived occurrence key, scoped to the exact version.
  stableKey            String   @unique
  /// contracts publicationClaimTargetSchema encoded as JSON. Adapter-specific
  /// target metadata stays inside this typed union.
  targetJson           String
  /// Exact externally published target URL resolved and verified by the
  /// format adapter before normalization. Addressing metadata, never identity.
  publishedUrl         String?
  /// contracts publicationClaimSourceBindingSchema encoded as JSON.
  sourceBindingJson    String
  /// contracts publicationClaimSelectorSchema encoded as JSON, carrying its
  /// explicit frame so source offsets are never mixed with rendered offsets.
  selectorJson         String
  /// Content digest over the declaration alone. Deliberately not unique:
  /// equal bytes are not one canonical claim.
  declarationSha256    String
  /// contracts PUBLICATION_CLAIM_DECLARATION_AUTHORITIES.
  declarationAuthority String
  /// Semantic declaration loaded from the one declared authority: either the
  /// publication-source record or the delegated review-manifest claim stream.
  text                 String?
  claimType            String?
  qualification        String?
  /// Explicit, reviewed canonical binding. Never inferred; null until an
  /// audited identity decision sets it, and immutable once set.
  knowledgeNodeId      String?
  createdAt            DateTime @default(now())

  publicationVersion PublicationVersion    @relation(fields: [publicationVersionId], references: [id], onDelete: Restrict)
  knowledgeNode      KnowledgeNode?        @relation("publicationClaimNode", fields: [knowledgeNodeId], references: [id], onDelete: Restrict)
  graphVersion       KnowledgeNodeVersion? @relation("publicationClaimGraphVersion")

  @@unique([publicationVersionId, sourceLocalClaimId])
  @@index([publicationVersionId])
  @@index([declarationSha256])
  @@index([knowledgeNodeId])
}
