# Check out text as LF everywhere so byte digests over fixtures and pinned source files match CI
# on Windows (core.autocrlf=true would otherwise rewrite them to CRLF).
* text=auto eol=lf

*.sh text eol=lf

# Byte-exact pinned fixtures: digests are sha256 of exact bytes (no CRLF on Windows checkouts)
packages/knowledge/src/fixtures/research-project-descriptors/** -text
scripts/producer-contracts/fixtures/** -text
